<component name="terminal_venous_connection">
<variable name="v_posterior_cerebral_L_T" public_interface="in" units="m3_per_s"/>
<variable name="v_posterior_cerebral_R_T" public_interface="in" units="m3_per_s"/>
<variable name="v_external_carotid_L_T" public_interface="in" units="m3_per_s"/>
<variable name="v_external_carotid_R_T" public_interface="in" units="m3_per_s"/>
<variable name="v_middle_cerebral_L_T" public_interface="in" units="m3_per_s"/>
<variable name="v_middle_cerebral_R_T" public_interface="in" units="m3_per_s"/>
<variable name="v_anterior_cerebral_L_T" public_interface="in" units="m3_per_s"/>
<variable name="v_anterior_cerebral_R_T" public_interface="in" units="m3_per_s"/>
<variable name="v_arm_L_T" public_interface="in" units="m3_per_s"/>
<variable name="v_arm_R_T" public_interface="in" units="m3_per_s"/>
<variable name="v_trunk_C_T" public_interface="in" units="m3_per_s"/>
<variable name="v_leg_L_T" public_interface="in" units="m3_per_s"/>
<variable name="v_leg_R_T" public_interface="in" units="m3_per_s"/>
<variable name="v_venous_lb" public_interface="out" units="m3_per_s"/>
<variable name="v_venous_ub" public_interface="out" units="m3_per_s"/>
<math xmlns="http://www.w3.org/1998/Math/MathML">
   <apply>
       <eq/>
       <ci>v_venous_lb</ci>
       <apply>
           <plus/>
            <ci>v_trunk_C_T</ci>
            <ci>v_leg_L_T</ci>
            <ci>v_leg_R_T</ci>
       </apply>
   </apply>
</math>
<math xmlns="http://www.w3.org/1998/Math/MathML">
   <apply>
       <eq/>
       <ci>v_venous_ub</ci>
       <apply>
           <plus/>
            <ci>v_posterior_cerebral_L_T</ci>
            <ci>v_posterior_cerebral_R_T</ci>
            <ci>v_external_carotid_L_T</ci>
            <ci>v_external_carotid_R_T</ci>
            <ci>v_middle_cerebral_L_T</ci>
            <ci>v_middle_cerebral_R_T</ci>
            <ci>v_anterior_cerebral_L_T</ci>
            <ci>v_anterior_cerebral_R_T</ci>
            <ci>v_arm_L_T</ci>
            <ci>v_arm_R_T</ci>
       </apply>
   </apply>
</math>
</component>
<!--&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;generic junction connection&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;&#45;//-->
