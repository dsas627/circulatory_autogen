              <apply>
                <times/>
                <ci>R</ci>
                <ci>v</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>beta_g</ci>
              <ci>rho</ci>
              <ci>g</ci>
              <ci>l</ci>
              <apply>
