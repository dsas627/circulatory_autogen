          <ci>x_CO2</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>x_CO2</ci>
            </apply>
            <ci>phi_P_CO2_a</ci>
          </apply>
          <ci>tau_CO2</ci>
