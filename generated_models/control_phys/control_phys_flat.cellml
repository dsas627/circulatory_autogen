      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <minus/>
              <ci>u</ci>
