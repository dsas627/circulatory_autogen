  <component name="arterial_gas_transport_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="C_O2_in" units="dimensionless" interface="public"/>
    <variable name="C_CO2_in" units="dimensionless" interface="public"/>
    <variable name="C_CO2_out_init" units="dimensionless" interface="public"/>
    <variable name="C_O2_out_init" units="dimensionless" interface="public"/>
    <variable name="C_O2_out" units="dimensionless" initial_value="C_O2_out_init" interface="public"/>
    <variable name="C_CO2_out" units="dimensionless" initial_value="C_CO2_out_init" interface="public"/>
    <variable name="dot_C_CO2_out" units="Hz" interface="public"/>
    <variable name="q_0" units="m3" interface="public"/>
    <variable name="v" units="m3_per_s" interface="public"/>
    <variable name="P_O2_out" units="J_per_m3" interface="public"/>
    <variable name="P_CO2_out" units="J_per_m3" interface="public"/>
    <variable name="k_1" units="J_per_m3" interface="public"/>
    <variable name="k_2" units="J_per_m3" interface="public"/>
    <variable name="h_1" units="dimensionless" interface="public"/>
    <variable name="h_2" units="dimensionless" interface="public"/>
    <variable name="d_1" units="J_per_m3" interface="public"/>
    <variable name="d_2" units="J_per_m3" interface="public"/>
    <variable name="r_1" units="J_per_m3" interface="public"/>
    <variable name="r_2" units="J_per_m3" interface="public"/>
    <variable name="s_1" units="J2_per_m6" interface="public"/>
    <variable name="s_2" units="J2_per_m6" interface="public"/>
    <variable name="alpha_1" units="m3_per_J" interface="public"/>
    <variable name="alpha_2" units="m3_per_J" interface="public"/>
    <variable name="beta_1" units="m3_per_J" interface="public"/>
    <variable name="beta_2" units="m3_per_J" interface="public"/>
    <variable name="C_O2_sat" units="dimensionless" interface="public"/>
    <variable name="C_CO2_sat" units="dimensionless" interface="public"/>
    <variable name="C_O2_out_capped" units="dimensionless" interface="public"/>
    <variable name="C_CO2_out_capped" units="dimensionless" interface="public"/>
    <variable name="C_O2_out_extra_ub" units="dimensionless" interface="public"/>
    <variable name="overcap_solubility" units="J_per_m3" interface="public"/>
    <variable name="saturation_cap" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>C_O2_out</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>v</ci>
            <apply>
              <minus/>
              <ci>C_O2_in</ci>
              <ci>C_O2_out</ci>
            </apply>
          </apply>
          <ci>q_0</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>dot_C_CO2_out</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>v</ci>
            <apply>
              <minus/>
              <ci>C_CO2_in</ci>
              <ci>C_CO2_out</ci>
            </apply>
          </apply>
          <ci>q_0</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>C_CO2_out</ci>
        </apply>
        <ci>dot_C_CO2_out</ci>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>P_O2_out</ci>
        <apply>
          <plus/>
          <ci>r_1</ci>
          <apply>
            <root/>
            <apply>
              <minus/>
              <apply>
                <power/>
                <ci>r_1</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
              <ci>s_1</ci>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>overcap_solubility</ci>
            <ci>C_O2_out_extra_ub</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>P_CO2_out</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>d_2</ci>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>P_O2_out</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <times/>
              <ci>beta_2</ci>
              <ci>P_O2_out</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>C_O2_out_capped</ci>
        <apply>
          <min/>
          <apply>
            <times/>
            <ci>C_O2_sat</ci>
            <ci>saturation_cap</ci>
          </apply>
          <ci>C_O2_out</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>C_CO2_out_capped</ci>
        <apply>
          <min/>
          <apply>
            <times/>
            <ci>C_CO2_sat</ci>
            <ci>saturation_cap</ci>
          </apply>
          <ci>C_CO2_out</ci>
        </apply>
      </apply>
      <!-- This is the amount that is extra in the plasma due to capping the amount that can be saturated.-->
      <apply>
        <eq/>
        <ci>C_O2_out_extra_ub</ci>
        <apply>
          <max/>
          <apply>
            <minus/>
            <ci>C_O2_out</ci>
            <apply>
              <times/>
              <ci>C_O2_sat</ci>
              <ci>saturation_cap</ci>
            </apply>
          </apply>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_1</ci>
        <apply>
          <max/>
          <apply>
            <times/>
            <ci>k_1</ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci>C_O2_out_capped</ci>
                <apply>
                  <minus/>
                  <ci>C_O2_sat</ci>
                  <ci>C_O2_out_capped</ci>
                </apply>
              </apply>
              <ci>h_1</ci>
            </apply>
          </apply>
          <cn cellml:units="J_per_m3">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_2</ci>
        <apply>
          <max/>
          <apply>
            <times/>
            <ci>k_2</ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci>C_CO2_out_capped</ci>
                <apply>
                  <minus/>
                  <ci>C_CO2_sat</ci>
                  <ci>C_CO2_out_capped</ci>
                </apply>
              </apply>
              <ci>h_2</ci>
            </apply>
          </apply>
          <cn cellml:units="J_per_m3">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>r_1</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <ci>beta_1</ci>
                    <ci>d_2</ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>beta_2</ci>
                  <ci>d_1</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>alpha_1</ci>
                <ci>alpha_2</ci>
                <ci>d_1</ci>
                <ci>d_2</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_2</ci>
            <apply>
              <times/>
              <ci>alpha_2</ci>
              <ci>beta_1</ci>
              <ci>d_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>r_2</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <ci>beta_2</ci>
                    <ci>d_1</ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>beta_1</ci>
                  <ci>d_2</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>alpha_1</ci>
                <ci>d_2</ci>
                <ci>d_1</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_1</ci>
            <apply>
              <times/>
              <ci>alpha_1</ci>
              <ci>beta_2</ci>
              <ci>d_1</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_1</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>d_1</ci>
              <apply>
                <times/>
                <ci>alpha_1</ci>
                <ci>d_1</ci>
                <ci>d_2</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_2</ci>
            <apply>
              <times/>
              <ci>alpha_2</ci>
              <ci>beta_1</ci>
              <ci>d_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_2</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>d_2</ci>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>d_2</ci>
                <ci>d_1</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_1</ci>
            <apply>
              <times/>
              <ci>alpha_1</ci>
              <ci>beta_2</ci>
              <ci>d_1</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="venous_gas_transport_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="C_O2_in" units="dimensionless" interface="public"/>
    <variable name="C_CO2_in" units="dimensionless" interface="public"/>
    <variable name="C_CO2_out_init" units="dimensionless" interface="public"/>
    <variable name="C_O2_out_init" units="dimensionless" interface="public"/>
    <variable name="C_O2_out" units="dimensionless" initial_value="C_O2_out_init" interface="public"/>
    <variable name="C_CO2_out" units="dimensionless" initial_value="C_CO2_out_init" interface="public"/>
    <variable name="dot_C_CO2_out" units="Hz" interface="public"/>
    <variable name="q_0" units="m3" interface="public"/>
    <variable name="v" units="m3_per_s" interface="public"/>
    <variable name="P_O2_out" units="J_per_m3" interface="public"/>
    <variable name="P_CO2_out" units="J_per_m3" interface="public"/>
    <variable name="k_1" units="J_per_m3" interface="public"/>
    <variable name="k_2" units="J_per_m3" interface="public"/>
    <variable name="h_1" units="dimensionless" interface="public"/>
    <variable name="h_2" units="dimensionless" interface="public"/>
    <variable name="d_1" units="J_per_m3" interface="public"/>
    <variable name="d_2" units="J_per_m3" interface="public"/>
    <variable name="r_1" units="J_per_m3" interface="public"/>
    <variable name="r_2" units="J_per_m3" interface="public"/>
    <variable name="s_1" units="J2_per_m6" interface="public"/>
    <variable name="s_2" units="J2_per_m6" interface="public"/>
    <variable name="alpha_1" units="m3_per_J" interface="public"/>
    <variable name="alpha_2" units="m3_per_J" interface="public"/>
    <variable name="beta_1" units="m3_per_J" interface="public"/>
    <variable name="beta_2" units="m3_per_J" interface="public"/>
    <variable name="C_O2_sat" units="dimensionless" interface="public"/>
    <variable name="C_CO2_sat" units="dimensionless" interface="public"/>
    <variable name="C_O2_out_capped" units="dimensionless" interface="public"/>
    <variable name="C_CO2_out_capped" units="dimensionless" interface="public"/>
    <variable name="C_O2_out_extra_ub" units="dimensionless" interface="public"/>
    <variable name="overcap_solubility" units="J_per_m3" interface="public"/>
    <variable name="saturation_cap" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>C_O2_out</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>v</ci>
            <apply>
              <minus/>
              <ci>C_O2_in</ci>
              <ci>C_O2_out</ci>
            </apply>
          </apply>
          <ci>q_0</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>dot_C_CO2_out</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>v</ci>
            <apply>
              <minus/>
              <ci>C_CO2_in</ci>
              <ci>C_CO2_out</ci>
            </apply>
          </apply>
          <ci>q_0</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>C_CO2_out</ci>
        </apply>
        <ci>dot_C_CO2_out</ci>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>P_O2_out</ci>
        <apply>
          <plus/>
          <ci>r_1</ci>
          <apply>
            <root/>
            <apply>
              <minus/>
              <apply>
                <power/>
                <ci>r_1</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
              <ci>s_1</ci>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>overcap_solubility</ci>
            <ci>C_O2_out_extra_ub</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>P_CO2_out</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>d_2</ci>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>P_O2_out</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <times/>
              <ci>beta_2</ci>
              <ci>P_O2_out</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>C_O2_out_capped</ci>
        <apply>
          <min/>
          <apply>
            <times/>
            <ci>C_O2_sat</ci>
            <ci>saturation_cap</ci>
          </apply>
          <ci>C_O2_out</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>C_CO2_out_capped</ci>
        <apply>
          <min/>
          <apply>
            <times/>
            <ci>C_CO2_sat</ci>
            <ci>saturation_cap</ci>
          </apply>
          <ci>C_CO2_out</ci>
        </apply>
      </apply>
      <!-- This is the amount that is extra in the plasma due to capping the amount that can be saturated.-->
      <apply>
        <eq/>
        <ci>C_O2_out_extra_ub</ci>
        <apply>
          <max/>
          <apply>
            <minus/>
            <ci>C_O2_out</ci>
            <apply>
              <times/>
              <ci>C_O2_sat</ci>
              <ci>saturation_cap</ci>
            </apply>
          </apply>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_1</ci>
        <apply>
          <max/>
          <apply>
            <times/>
            <ci>k_1</ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci>C_O2_out_capped</ci>
                <apply>
                  <minus/>
                  <ci>C_O2_sat</ci>
                  <ci>C_O2_out_capped</ci>
                </apply>
              </apply>
              <ci>h_1</ci>
            </apply>
          </apply>
          <cn cellml:units="J_per_m3">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_2</ci>
        <apply>
          <max/>
          <apply>
            <times/>
            <ci>k_2</ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci>C_CO2_out_capped</ci>
                <apply>
                  <minus/>
                  <ci>C_CO2_sat</ci>
                  <ci>C_CO2_out_capped</ci>
                </apply>
              </apply>
              <ci>h_2</ci>
            </apply>
          </apply>
          <cn cellml:units="J_per_m3">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>r_1</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <ci>beta_1</ci>
                    <ci>d_2</ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>beta_2</ci>
                  <ci>d_1</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>alpha_1</ci>
                <ci>alpha_2</ci>
                <ci>d_1</ci>
                <ci>d_2</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_2</ci>
            <apply>
              <times/>
              <ci>alpha_2</ci>
              <ci>beta_1</ci>
              <ci>d_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>r_2</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <ci>beta_2</ci>
                    <ci>d_1</ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>beta_1</ci>
                  <ci>d_2</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>alpha_1</ci>
                <ci>d_2</ci>
                <ci>d_1</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_1</ci>
            <apply>
              <times/>
              <ci>alpha_1</ci>
              <ci>beta_2</ci>
              <ci>d_1</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_1</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>d_1</ci>
              <apply>
                <times/>
                <ci>alpha_1</ci>
                <ci>d_1</ci>
                <ci>d_2</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_2</ci>
            <apply>
              <times/>
              <ci>alpha_2</ci>
              <ci>beta_1</ci>
              <ci>d_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_2</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>d_2</ci>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>d_2</ci>
                <ci>d_1</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_1</ci>
            <apply>
              <times/>
              <ci>alpha_1</ci>
              <ci>beta_2</ci>
              <ci>d_1</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="common_carotid_L_baro_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="P_sys" units="J_per_m3" interface="public"/>
    <variable name="P_baro_init" units="J_per_m3" interface="public"/>
    <variable name="P_baro" units="J_per_m3" initial_value="P_baro_init" interface="public"/>
    <variable name="f_ab" units="Hz" interface="public"/>
    <variable name="dP_sys_dt" units="J_per_m3s" interface="public"/>
    <variable name="P_nom" units="J_per_m3" interface="public"/>
    <variable name="f_ab_min" units="Hz" interface="public"/>
    <variable name="f_ab_max" units="Hz" interface="public"/>
    <variable name="k_ab" units="J_per_m3" interface="public"/>
    <variable name="tau_zb" units="second" interface="public"/>
    <variable name="tau_pb" units="second" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>P_baro</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <ci>P_sys</ci>
              <apply>
                <times/>
                <ci>tau_zb</ci>
                <ci>dP_sys_dt</ci>
              </apply>
            </apply>
            <ci>P_baro</ci>
          </apply>
          <ci>tau_pb</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>f_ab</ci>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <ci>f_ab_min</ci>
            <apply>
              <times/>
              <ci>f_ab_max</ci>
              <apply>
                <exp/>
                <apply>
                  <divide/>
                  <apply>
                    <minus/>
                    <ci>P_baro</ci>
                    <ci>P_nom</ci>
                  </apply>
                  <ci>k_ab</ci>
                </apply>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <ci>P_baro</ci>
                  <ci>P_nom</ci>
                </apply>
                <ci>k_ab</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="arterial_chemoreceptor_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="C_CO2_a" units="dimensionless" interface="public"/>
    <variable name="C_O2_a" units="dimensionless" interface="public"/>
    <variable name="dot_C_CO2_a" units="Hz" interface="public"/>
    <variable name="X_O2" units="dimensionless" interface="public"/>
    <variable name="phi_stat" units="Hz" interface="public"/>
    <variable name="phi_CO2_dyn" units="Hz" initial_value="0.0" interface="public"/>
    <variable name="f_c_stat" units="Hz" interface="public"/>
    <variable name="f_c_dyn" units="Hz" interface="public"/>
    <variable name="f_apc" units="Hz" interface="public"/>
    <variable name="phi_apc" units="Hz" initial_value="0.0" interface="public"/>
    <variable name="P_O2_a" units="J_per_m3" interface="public"/>
    <variable name="AA" units="dimensionless" interface="public"/>
    <variable name="BB" units="dimensionless" interface="public"/>
    <variable name="C_CO2_a_nom" units="dimensionless" interface="public"/>
    <variable name="K_O2" units="dimensionless" interface="public"/>
    <variable name="K_CO2" units="Hz" interface="public"/>
    <variable name="K_stat" units="Hz" interface="public"/>
    <variable name="K_dyn" units="Hz" interface="public"/>
    <variable name="tau_cap" units="second" interface="public"/>
    <variable name="tau_CO2_cc_dyn" units="dimensionless" interface="public"/>
    <variable name="C_O2_a_diss" units="dimensionless" interface="public"/>
    <variable name="S_O2_a" units="dimensionless" interface="public"/>
    <variable name="Hgb" units="kg_per_m3" interface="public"/>
    <variable name="alpha_O2" units="m3_per_J" interface="public"/>
    <variable name="k_1" units="J_per_m3" interface="public"/>
    <variable name="k_2" units="J_per_m3" interface="public"/>
    <variable name="h_1" units="dimensionless" interface="public"/>
    <variable name="h_2" units="dimensionless" interface="public"/>
    <variable name="d_1" units="J_per_m3" interface="public"/>
    <variable name="d_2" units="J_per_m3" interface="public"/>
    <variable name="r_1" units="J_per_m3" interface="public"/>
    <variable name="r_2" units="J_per_m3" interface="public"/>
    <variable name="s_1" units="J2_per_m6" interface="public"/>
    <variable name="s_2" units="J2_per_m6" interface="public"/>
    <variable name="alpha_1" units="m3_per_J" interface="public"/>
    <variable name="alpha_2" units="m3_per_J" interface="public"/>
    <variable name="beta_1" units="m3_per_J" interface="public"/>
    <variable name="beta_2" units="m3_per_J" interface="public"/>
    <variable name="C_O2_sat" units="dimensionless" interface="public"/>
    <variable name="C_CO2_sat" units="dimensionless" interface="public"/>
    <variable name="C_O2_a_capped" units="dimensionless" interface="public"/>
    <variable name="C_CO2_a_capped" units="dimensionless" interface="public"/>
    <variable name="C_O2_a_extra_ub" units="dimensionless" interface="public"/>
    <variable name="overcap_solubility" units="J_per_m3" interface="public"/>
    <variable name="saturation_cap" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>X_O2</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <ci>AA</ci>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>S_O2_a</ci>
            </apply>
          </apply>
          <ci>BB</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>phi_stat</ci>
        <apply>
          <times/>
          <ci>K_CO2</ci>
          <apply>
            <minus/>
            <ci>C_CO2_a</ci>
            <ci>C_CO2_a_nom</ci>
          </apply>
          <ci>K_O2</ci>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <ci>X_O2</ci>
                </apply>
                <ci>K_O2</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>f_c_stat</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>K_stat</ci>
              <apply>
                <minus/>
                <cn cellml:units="dimensionless">1</cn>
                <apply>
                  <exp/>
                  <apply>
                    <divide/>
                    <apply>
                      <minus/>
                      <ci>phi_stat</ci>
                    </apply>
                    <ci>K_stat</ci>
                  </apply>
                </apply>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>C_CO2_a</ci>
              <ci>C_CO2_a_nom</ci>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="Hz">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>phi_CO2_dyn</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <times/>
              <ci>dot_C_CO2_a</ci>
              <ci>tau_CO2_cc_dyn</ci>
            </apply>
            <ci>phi_CO2_dyn</ci>
          </apply>
          <ci>tau_cap</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>f_c_dyn</ci>
        <apply>
          <times/>
          <ci>K_dyn</ci>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <ci>phi_CO2_dyn</ci>
                </apply>
                <ci>K_dyn</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>phi_apc</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <ci>f_c_stat</ci>
              <ci>f_c_dyn</ci>
            </apply>
            <ci>phi_apc</ci>
          </apply>
          <ci>tau_cap</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>f_apc</ci>
        <apply>
          <max/>
          <ci>phi_apc</ci>
          <cn cellml:units="Hz">0</cn>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>P_O2_a</ci>
        <apply>
          <plus/>
          <ci>r_1</ci>
          <apply>
            <root/>
            <apply>
              <minus/>
              <apply>
                <power/>
                <ci>r_1</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
              <ci>s_1</ci>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>overcap_solubility</ci>
            <ci>C_O2_a_extra_ub</ci>
          </apply>
        </apply>
      </apply>
      <!-- P_CO2_a = d_2*(1{dimensionless}+alpha_2*P_O2_p)/(1{dimensionless}+beta_2*P_O2_p);
 TODO I need to check this, it is different to the Ursino papers and to the gas exchange modules.-->
      <apply>
        <eq/>
        <ci>C_O2_a_diss</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>P_O2_a</ci>
              <ci>alpha_O2</ci>
            </apply>
            <apply>
              <geq/>
              <apply>
                <minus/>
                <apply>
                  <minus/>
                  <ci>C_O2_sat</ci>
                  <apply>
                    <times/>
                    <ci>Hgb</ci>
                    <cn type="e-notation" cellml:units="m3_per_kg">1.34<sep/>-3</cn>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>P_O2_a</ci>
                  <ci>alpha_O2</ci>
                </apply>
              </apply>
              <cn cellml:units="dimensionless">0</cn>
            </apply>
          </piece>
          <otherwise>
            <apply>
              <minus/>
              <ci>C_O2_sat</ci>
              <apply>
                <times/>
                <ci>Hgb</ci>
                <cn type="e-notation" cellml:units="m3_per_kg">1.34<sep/>-3</cn>
              </apply>
            </apply>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>S_O2_a</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>C_O2_a</ci>
            <ci>C_O2_a_diss</ci>
          </apply>
          <apply>
            <times/>
            <ci>Hgb</ci>
            <cn type="e-notation" cellml:units="m3_per_kg">1.34<sep/>-3</cn>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>C_O2_a_capped</ci>
        <apply>
          <min/>
          <apply>
            <times/>
            <ci>C_O2_sat</ci>
            <ci>saturation_cap</ci>
          </apply>
          <ci>C_O2_a</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>C_CO2_a_capped</ci>
        <apply>
          <min/>
          <apply>
            <times/>
            <ci>C_CO2_sat</ci>
            <ci>saturation_cap</ci>
          </apply>
          <ci>C_CO2_a</ci>
        </apply>
      </apply>
      <!-- This is the amount that is extra in the plasma due to capping the amount that can be saturated.-->
      <apply>
        <eq/>
        <ci>C_O2_a_extra_ub</ci>
        <apply>
          <max/>
          <apply>
            <minus/>
            <ci>C_O2_a</ci>
            <apply>
              <times/>
              <ci>C_O2_sat</ci>
              <ci>saturation_cap</ci>
            </apply>
          </apply>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_1</ci>
        <apply>
          <max/>
          <apply>
            <times/>
            <ci>k_1</ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci>C_O2_a_capped</ci>
                <apply>
                  <minus/>
                  <ci>C_O2_sat</ci>
                  <ci>C_O2_a_capped</ci>
                </apply>
              </apply>
              <ci>h_1</ci>
            </apply>
          </apply>
          <cn cellml:units="J_per_m3">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_2</ci>
        <apply>
          <max/>
          <apply>
            <times/>
            <ci>k_2</ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci>C_CO2_a_capped</ci>
                <apply>
                  <minus/>
                  <ci>C_CO2_sat</ci>
                  <ci>C_CO2_a_capped</ci>
                </apply>
              </apply>
              <ci>h_2</ci>
            </apply>
          </apply>
          <cn cellml:units="J_per_m3">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>r_1</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <ci>beta_1</ci>
                    <ci>d_2</ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>beta_2</ci>
                  <ci>d_1</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>alpha_1</ci>
                <ci>alpha_2</ci>
                <ci>d_1</ci>
                <ci>d_2</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_2</ci>
            <apply>
              <times/>
              <ci>alpha_2</ci>
              <ci>beta_1</ci>
              <ci>d_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>r_2</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <ci>beta_2</ci>
                    <ci>d_1</ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>beta_1</ci>
                  <ci>d_2</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>alpha_1</ci>
                <ci>d_2</ci>
                <ci>d_1</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_1</ci>
            <apply>
              <times/>
              <ci>alpha_1</ci>
              <ci>beta_2</ci>
              <ci>d_1</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_1</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>d_1</ci>
              <apply>
                <times/>
                <ci>alpha_1</ci>
                <ci>d_1</ci>
                <ci>d_2</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_2</ci>
            <apply>
              <times/>
              <ci>alpha_2</ci>
              <ci>beta_1</ci>
              <ci>d_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_2</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>d_2</ci>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>d_2</ci>
                <ci>d_1</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_1</ci>
            <apply>
              <times/>
              <ci>alpha_1</ci>
              <ci>beta_2</ci>
              <ci>d_1</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="vagal_efferent_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_ev_0" units="Hz" interface="public"/>
    <variable name="f_ev_inf" units="Hz" interface="public"/>
    <variable name="f_ab_0" units="Hz" interface="public"/>
    <variable name="theta_v" units="Hz" interface="public"/>
    <variable name="W_cv" units="dimensionless" interface="public"/>
    <variable name="k_ev" units="Hz" interface="public"/>
    <variable name="f_apc" units="Hz" interface="public"/>
    <variable name="f_ab" units="Hz" interface="public"/>
    <variable name="f_v" units="Hz" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>f_v</ci>
        <apply>
          <minus/>
          <apply>
            <plus/>
            <apply>
              <divide/>
              <apply>
                <plus/>
                <ci>f_ev_0</ci>
                <apply>
                  <times/>
                  <ci>f_ev_inf</ci>
                  <apply>
                    <exp/>
                    <apply>
                      <divide/>
                      <apply>
                        <minus/>
                        <ci>f_ab</ci>
                        <ci>f_ab_0</ci>
                      </apply>
                      <ci>k_ev</ci>
                    </apply>
                  </apply>
                </apply>
              </apply>
              <apply>
                <plus/>
                <cn cellml:units="dimensionless">1</cn>
                <apply>
                  <exp/>
                  <apply>
                    <divide/>
                    <apply>
                      <minus/>
                      <ci>f_ab</ci>
                      <ci>f_ab_0</ci>
                    </apply>
                    <ci>k_ev</ci>
                  </apply>
                </apply>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>W_cv</ci>
              <ci>f_apc</ci>
            </apply>
          </apply>
          <ci>theta_v</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="sympathetic_efferent_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="f_es_0" units="Hz" interface="public"/>
    <variable name="f_es_inf" units="Hz" interface="public"/>
    <variable name="f_es_max" units="Hz" interface="public"/>
    <variable name="k_es" units="second" interface="public"/>
    <variable name="W_bs" units="dimensionless" interface="public"/>
    <variable name="W_cs" units="dimensionless" interface="public"/>
    <variable name="f_apc" units="Hz" interface="public"/>
    <variable name="f_ab" units="Hz" interface="public"/>
    <variable name="f_s_premax" units="Hz" interface="public"/>
    <variable name="f_s" units="Hz" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>f_s_premax</ci>
        <apply>
          <plus/>
          <ci>f_es_inf</ci>
          <apply>
            <times/>
            <apply>
              <minus/>
              <ci>f_es_0</ci>
              <ci>f_es_inf</ci>
            </apply>
            <apply>
              <exp/>
              <apply>
                <times/>
                <ci>k_es</ci>
                <apply>
                  <plus/>
                  <apply>
                    <times/>
                    <ci>W_bs</ci>
                    <ci>f_ab</ci>
                  </apply>
                  <apply>
                    <times/>
                    <ci>W_cs</ci>
                    <ci>f_apc</ci>
                  </apply>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- + w_cp*f_cp + w_ls*f_ls));-->
      <!--IGNORING CNS and LUNG STRETCH-->
      <apply>
        <eq/>
        <ci>f_s</ci>
        <piecewise>
          <piece>
            <ci>f_s_premax</ci>
            <apply>
              <leq/>
              <ci>f_s_premax</ci>
              <ci>f_es_max</ci>
            </apply>
          </piece>
          <otherwise>
            <ci>f_es_max</ci>
          </otherwise>
        </piecewise>
      </apply>
    </math>
  </component>
  <component name="trunk_resistance_effector_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="G_theta" units="dimensionless" interface="public"/>
    <variable name="f_es_min" units="Hz" interface="public"/>
    <variable name="f_es_mid" units="Hz" interface="public"/>
    <variable name="tau_theta" units="second" interface="public"/>
    <variable name="f_s" units="Hz" interface="public"/>
    <variable name="Delta_theta" units="dimensionless" interface="public"/>
    <variable name="sigma_theta" units="Hz" initial_value="0.0" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>sigma_theta</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <max/>
              <apply>
                <minus/>
                <ci>f_s</ci>
                <ci>f_es_min</ci>
              </apply>
              <cn cellml:units="Hz">0</cn>
            </apply>
            <ci>sigma_theta</ci>
          </apply>
          <ci>tau_theta</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Delta_theta</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>G_theta</ci>
            <ci>sigma_theta</ci>
          </apply>
          <apply>
            <plus/>
            <ci>f_es_mid</ci>
            <ci>sigma_theta</ci>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="arm_leg_resistance_effector_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="G_theta" units="dimensionless" interface="public"/>
    <variable name="f_es_min" units="Hz" interface="public"/>
    <variable name="f_es_mid" units="Hz" interface="public"/>
    <variable name="tau_theta" units="second" interface="public"/>
    <variable name="f_s" units="Hz" interface="public"/>
    <variable name="Delta_theta" units="dimensionless" interface="public"/>
    <variable name="sigma_theta" units="Hz" initial_value="0.0" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>sigma_theta</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <max/>
              <apply>
                <minus/>
                <ci>f_s</ci>
                <ci>f_es_min</ci>
              </apply>
              <cn cellml:units="Hz">0</cn>
            </apply>
            <ci>sigma_theta</ci>
          </apply>
          <ci>tau_theta</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Delta_theta</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>G_theta</ci>
            <ci>sigma_theta</ci>
          </apply>
          <apply>
            <plus/>
            <ci>f_es_mid</ci>
            <ci>sigma_theta</ci>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="lv_elastance_effector_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="G_theta" units="J_per_m6" interface="public"/>
    <variable name="f_es_min" units="Hz" interface="public"/>
    <variable name="tau_theta" units="second" interface="public"/>
    <variable name="f_s" units="Hz" interface="public"/>
    <variable name="Delta_theta" units="J_per_m6" initial_value="0.0" interface="public"/>
    <variable name="sigma_theta" units="J_per_m6" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>sigma_theta</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>G_theta</ci>
              <apply>
                <ln/>
                <apply>
                  <times/>
                  <cn cellml:units="second">1</cn>
                  <apply>
                    <plus/>
                    <apply>
                      <minus/>
                      <ci>f_s</ci>
                      <ci>f_es_min</ci>
                    </apply>
                    <cn cellml:units="Hz">1</cn>
                  </apply>
                </apply>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>f_s</ci>
              <ci>f_es_min</ci>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="J_per_m6">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Delta_theta</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>Delta_theta</ci>
            </apply>
            <ci>sigma_theta</ci>
          </apply>
          <ci>tau_theta</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="rv_elastance_effector_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="G_theta" units="J_per_m6" interface="public"/>
    <variable name="f_es_min" units="Hz" interface="public"/>
    <variable name="tau_theta" units="second" interface="public"/>
    <variable name="f_s" units="Hz" interface="public"/>
    <variable name="Delta_theta" units="J_per_m6" initial_value="0.0" interface="public"/>
    <variable name="sigma_theta" units="J_per_m6" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>sigma_theta</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>G_theta</ci>
              <apply>
                <ln/>
                <apply>
                  <times/>
                  <cn cellml:units="second">1</cn>
                  <apply>
                    <plus/>
                    <apply>
                      <minus/>
                      <ci>f_s</ci>
                      <ci>f_es_min</ci>
                    </apply>
                    <cn cellml:units="Hz">1</cn>
                  </apply>
                </apply>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>f_s</ci>
              <ci>f_es_min</ci>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="J_per_m6">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Delta_theta</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>Delta_theta</ci>
            </apply>
            <ci>sigma_theta</ci>
          </apply>
          <ci>tau_theta</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="heart_period_effector_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="G_Ts" units="second" interface="public"/>
    <variable name="G_Tv" units="s2" interface="public"/>
    <variable name="f_es_min" units="Hz" interface="public"/>
    <variable name="tau_Ts" units="second" interface="public"/>
    <variable name="tau_Tv" units="second" interface="public"/>
    <variable name="f_s" units="Hz" interface="public"/>
    <variable name="f_v" units="Hz" interface="public"/>
    <variable name="Delta_Ts" units="second" initial_value="0.0" interface="public"/>
    <variable name="Delta_Tv" units="second" initial_value="0.0" interface="public"/>
    <variable name="Delta_T" units="second" interface="public"/>
    <variable name="sigma_Ts" units="second" interface="public"/>
    <variable name="sigma_Tv" units="second" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>sigma_Ts</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>G_Ts</ci>
              <apply>
                <ln/>
                <apply>
                  <times/>
                  <cn cellml:units="second">1</cn>
                  <apply>
                    <plus/>
                    <apply>
                      <minus/>
                      <ci>f_s</ci>
                      <ci>f_es_min</ci>
                    </apply>
                    <cn cellml:units="Hz">1</cn>
                  </apply>
                </apply>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>f_s</ci>
              <ci>f_es_min</ci>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="second">0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Delta_Ts</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>Delta_Ts</ci>
            </apply>
            <ci>sigma_Ts</ci>
          </apply>
          <ci>tau_Ts</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>sigma_Tv</ci>
        <apply>
          <times/>
          <ci>G_Tv</ci>
          <ci>f_v</ci>
        </apply>
      </apply>
      <!--DELAY IGNORED-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>Delta_Tv</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <minus/>
              <ci>Delta_Tv</ci>
            </apply>
            <ci>sigma_Tv</ci>
          </apply>
          <ci>tau_Tv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>Delta_T</ci>
        <apply>
          <plus/>
          <ci>Delta_Tv</ci>
          <ci>Delta_Ts</ci>
        </apply>
      </apply>
    </math>
