            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <exp/>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <ci>P_CO2_a</ci>
                  <ci>P_CO2_a_nom</ci>
                </apply>
