            <ci>q_C</ci>
            <ci>C</ci>
          </apply>
          <ci>u_ext</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C</ci>
          <apply>
            <times/>
            <ci>R_v</ci>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <ci>v</ci>
                <ci>v_out_1</ci>
              </apply>
              <ci>v_out_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
