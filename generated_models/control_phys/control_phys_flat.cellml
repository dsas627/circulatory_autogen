              <cn cellml:units="dimensionless">4</cn>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R_v</ci>
        <apply>
          <divide/>
          <cn cellml:units="second">0.01</cn>
          <ci>C</ci>
        </apply>
      </apply>
      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <minus/>
              <apply>
                <minus/>
