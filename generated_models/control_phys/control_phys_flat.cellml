            </apply>
            <apply>
              <times/>
              <ci>C_CO2_p_anterior_cerebral_L_GE</ci>
              <ci>v_external_carotid_L_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_CO2_p_anterior_cerebral_R_GE</ci>
