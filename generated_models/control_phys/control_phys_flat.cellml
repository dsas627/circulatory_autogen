    <variable name="C_O2_p_posterior_cerebral_L_GE" units="dimensionless" interface="public"/>
    <variable name="C_CO2_p_posterior_cerebral_L_GE" units="dimensionless" interface="public"/>
    <variable name="C_O2_p_posterior_cerebral_R_GE" units="dimensionless" interface="public"/>
    <variable name="C_CO2_p_posterior_cerebral_R_GE" units="dimensionless" interface="public"/>
    <variable name="C_O2_p_external_carotid_L_GE" units="dimensionless" interface="public"/>
