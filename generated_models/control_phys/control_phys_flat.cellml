    <variable name="alpha_2" units="m3_per_J" interface="public"/>
    <variable name="beta_1" units="m3_per_J" interface="public"/>
    <variable name="beta_2" units="m3_per_J" interface="public"/>
    <variable name="C_O2_sat" units="dimensionless" interface="public"/>
    <variable name="C_CO2_sat" units="dimensionless" interface="public"/>
    <variable name="C_O2_p_capped" units="dimensionless" interface="public"/>
    <variable name="C_CO2_p_capped" units="dimensionless" interface="public"/>
    <variable name="C_O2_p_extra_ub" units="dimensionless" interface="public"/>
    <variable name="overcap_solubility" units="J_per_m3" interface="public"/>
    <variable name="saturation_cap" units="dimensionless" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>M_O2</ci>
        <apply>
          <times/>
          <ci>k_O2</ci>
          <apply>
            <minus/>
            <ci>P_O2_A</ci>
            <ci>P_O2_p</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>M_CO2</ci>
        <apply>
          <times/>
          <ci>k_CO2</ci>
          <apply>
            <minus/>
            <ci>P_CO2_A</ci>
            <ci>P_CO2_p</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>C_O2_p</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>v_p</ci>
              <apply>
                <minus/>
                <ci>C_O2_v</ci>
                <ci>C_O2_p</ci>
              </apply>
            </apply>
            <ci>M_O2</ci>
          </apply>
          <ci>q_0</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_C_O2_p_dt</ci>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>v_p</ci>
              <apply>
                <minus/>
                <ci>C_CO2_v</ci>
                <ci>C_CO2_p</ci>
              </apply>
            </apply>
            <ci>M_CO2</ci>
          </apply>
          <ci>q_0</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>C_CO2_p</ci>
        </apply>
        <ci>d_C_O2_p_dt</ci>
      </apply>
      <!-- from inverted dissociation-->
      <apply>
        <eq/>
        <ci>P_O2_p</ci>
        <apply>
          <plus/>
          <ci>r_1</ci>
          <apply>
            <root/>
            <apply>
              <minus/>
              <apply>
                <power/>
                <ci>r_1</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
              <ci>s_1</ci>
            </apply>
          </apply>
          <apply>
            <times/>
            <ci>overcap_solubility</ci>
            <ci>C_O2_p_extra_ub</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>P_CO2_p</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>d_2</ci>
            <apply>
              <plus/>
              <cn cellml:units="dimensionless">1</cn>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>P_O2_p</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <times/>
              <ci>beta_2</ci>
              <ci>P_O2_p</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- flows from shunt todo model this??-->
      <apply>
        <eq/>
        <ci>v_p</ci>
        <apply>
          <times/>
          <ci>v</ci>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <ci>shunt_fraction</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v_sh</ci>
        <apply>
          <times/>
          <ci>v</ci>
          <ci>shunt_fraction</ci>
        </apply>
      </apply>
      <!-- calculate arterial gas concentration due to pulmonary shunt-->
      <!-- the 0 should be dimensionless (m3_per_s ->dim)-->
      <apply>
        <eq/>
        <ci>C_O2_a</ci>
        <apply>
          <max/>
          <apply>
            <divide/>
            <apply>
              <plus/>
              <apply>
                <times/>
                <ci>v_p</ci>
                <ci>C_O2_p</ci>
              </apply>
              <apply>
                <times/>
                <ci>v_sh</ci>
                <ci>C_O2_v</ci>
              </apply>
            </apply>
            <ci>v</ci>
          </apply>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>C_CO2_a</ci>
        <apply>
          <max/>
          <apply>
            <divide/>
            <apply>
              <plus/>
              <apply>
                <times/>
                <ci>v_p</ci>
                <ci>C_CO2_p</ci>
              </apply>
              <apply>
                <times/>
                <ci>v_sh</ci>
                <ci>C_CO2_v</ci>
              </apply>
            </apply>
            <ci>v</ci>
          </apply>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>C_O2_p_capped</ci>
        <apply>
          <min/>
          <apply>
            <times/>
            <ci>C_O2_sat</ci>
            <ci>saturation_cap</ci>
          </apply>
          <ci>C_O2_p</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>C_CO2_p_capped</ci>
        <apply>
          <min/>
          <apply>
            <times/>
            <ci>C_CO2_sat</ci>
            <ci>saturation_cap</ci>
          </apply>
          <ci>C_CO2_p</ci>
        </apply>
      </apply>
      <!-- This is the amount that is extra in the plasma due to capping the amount that can be saturated.-->
      <apply>
        <eq/>
        <ci>C_O2_p_extra_ub</ci>
        <apply>
          <max/>
          <apply>
            <minus/>
            <ci>C_O2_p</ci>
            <apply>
              <times/>
              <ci>C_O2_sat</ci>
              <ci>saturation_cap</ci>
            </apply>
          </apply>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_1</ci>
        <apply>
          <max/>
          <apply>
            <times/>
            <ci>k_1</ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci>C_O2_p_capped</ci>
                <apply>
                  <minus/>
                  <ci>C_O2_sat</ci>
                  <ci>C_O2_p_capped</ci>
                </apply>
              </apply>
              <ci>h_1</ci>
            </apply>
          </apply>
          <cn cellml:units="J_per_m3">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>d_2</ci>
        <apply>
          <max/>
          <apply>
            <times/>
            <ci>k_2</ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci>C_CO2_p_capped</ci>
                <apply>
                  <minus/>
                  <ci>C_CO2_sat</ci>
                  <ci>C_CO2_p_capped</ci>
                </apply>
              </apply>
              <ci>h_2</ci>
            </apply>
          </apply>
          <cn cellml:units="J_per_m3">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>r_1</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <ci>beta_1</ci>
                    <ci>d_2</ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>beta_2</ci>
                  <ci>d_1</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>alpha_1</ci>
                <ci>alpha_2</ci>
                <ci>d_1</ci>
                <ci>d_2</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_2</ci>
            <apply>
              <times/>
              <ci>alpha_2</ci>
              <ci>beta_1</ci>
              <ci>d_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>r_2</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <cn cellml:units="dimensionless">1</cn>
                  <apply>
                    <times/>
                    <ci>beta_2</ci>
                    <ci>d_1</ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <ci>beta_1</ci>
                  <ci>d_2</ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>alpha_1</ci>
                <ci>d_2</ci>
                <ci>d_1</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_1</ci>
            <apply>
              <times/>
              <ci>alpha_1</ci>
              <ci>beta_2</ci>
              <ci>d_1</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_1</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>d_1</ci>
              <apply>
                <times/>
                <ci>alpha_1</ci>
                <ci>d_1</ci>
                <ci>d_2</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_2</ci>
            <apply>
              <times/>
              <ci>alpha_2</ci>
              <ci>beta_1</ci>
              <ci>d_2</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_2</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
              <plus/>
              <ci>d_2</ci>
              <apply>
                <times/>
                <ci>alpha_2</ci>
                <ci>d_2</ci>
                <ci>d_1</ci>
              </apply>
            </apply>
          </apply>
          <apply>
            <plus/>
            <ci>beta_1</ci>
            <apply>
              <times/>
              <ci>alpha_1</ci>
              <ci>beta_2</ci>
              <ci>d_1</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="respiratory_gt_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="F_O2_i" units="dimensionless" interface="public"/>
    <variable name="F_CO2_i" units="dimensionless" interface="public"/>
    <variable name="P_atm" units="J_per_m3" interface="public"/>
    <variable name="P_ws" units="J_per_m3" interface="public"/>
    <variable name="F_O2_D_init" units="dimensionless" interface="public"/>
    <variable name="F_O2_A_init" units="dimensionless" interface="public"/>
    <variable name="F_CO2_D_init" units="dimensionless" interface="public"/>
    <variable name="F_CO2_A_init" units="dimensionless" interface="public"/>
    <variable name="K_LOSSES" units="dimensionless" interface="public"/>
    <variable name="F_O2_D" units="dimensionless" initial_value="F_O2_D_init" interface="public"/>
    <variable name="F_CO2_D" units="dimensionless" initial_value="F_CO2_D_init" interface="public"/>
    <variable name="F_O2_A" units="dimensionless" initial_value="F_O2_A_init" interface="public"/>
    <variable name="F_CO2_A" units="dimensionless" initial_value="F_CO2_A_init" interface="public"/>
    <variable name="P_O2_A" units="J_per_m3" interface="public"/>
    <variable name="P_CO2_A" units="J_per_m3" interface="public"/>
    <variable name="v_ml" units="m3_per_s" interface="public"/>
    <variable name="v_bA" units="m3_per_s" interface="public"/>
    <variable name="q_D" units="m3" interface="public"/>
    <variable name="q_A" units="m3" interface="public"/>
    <variable name="M_O2" units="m3_per_s" interface="public"/>
    <variable name="M_CO2" units="m3_per_s" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>F_O2_D</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <times/>
              <apply>
                <max/>
                <ci>v_ml</ci>
                <cn cellml:units="m3_per_s">0</cn>
              </apply>
              <apply>
                <minus/>
                <ci>F_O2_i</ci>
                <ci>F_O2_D</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <apply>
                <max/>
                <apply>
                  <minus/>
                  <ci>v_bA</ci>
                </apply>
                <cn cellml:units="m3_per_s">0</cn>
              </apply>
              <apply>
                <minus/>
                <ci>F_O2_D</ci>
                <ci>F_O2_A</ci>
              </apply>
            </apply>
          </apply>
          <ci>q_D</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>F_CO2_D</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <times/>
              <apply>
                <max/>
                <ci>v_ml</ci>
                <cn cellml:units="m3_per_s">0</cn>
              </apply>
              <apply>
                <minus/>
                <ci>F_CO2_i</ci>
                <ci>F_CO2_D</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <apply>
                <max/>
                <apply>
                  <minus/>
                  <ci>v_bA</ci>
                </apply>
                <cn cellml:units="m3_per_s">0</cn>
              </apply>
              <apply>
                <minus/>
                <ci>F_CO2_D</ci>
                <ci>F_CO2_A</ci>
              </apply>
            </apply>
          </apply>
          <ci>q_D</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>F_O2_A</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <times/>
              <apply>
                <max/>
                <ci>v_bA</ci>
                <cn cellml:units="m3_per_s">0</cn>
              </apply>
              <apply>
                <minus/>
                <ci>F_O2_D</ci>
                <ci>F_O2_A</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>K_LOSSES</ci>
              <ci>M_O2</ci>
            </apply>
          </apply>
          <ci>q_A</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>F_CO2_A</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <times/>
              <apply>
                <max/>
                <ci>v_bA</ci>
                <cn cellml:units="m3_per_s">0</cn>
              </apply>
              <apply>
                <minus/>
                <ci>F_CO2_D</ci>
                <ci>F_CO2_A</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>K_LOSSES</ci>
              <ci>M_CO2</ci>
            </apply>
          </apply>
          <ci>q_A</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>P_O2_A</ci>
        <apply>
          <times/>
          <ci>F_O2_A</ci>
          <apply>
            <minus/>
            <ci>P_atm</ci>
            <ci>P_ws</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>P_CO2_A</ci>
        <apply>
          <times/>
          <ci>F_CO2_A</ci>
          <apply>
            <minus/>
            <ci>P_atm</ci>
            <ci>P_ws</ci>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="lung_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="P_m" units="J_per_m3" interface="public"/>
    <variable name="P_l" units="J_per_m3" interface="public"/>
    <variable name="P_t" units="J_per_m3" interface="public"/>
    <variable name="P_b" units="J_per_m3" interface="public"/>
    <variable name="P_A" units="J_per_m3" interface="public"/>
    <variable name="P_pl" units="J_per_m3" interface="public"/>
    <variable name="P_mus" units="J_per_m3" interface="public"/>
    <variable name="P_mus_min" units="J_per_m3" interface="public"/>
    <variable name="P_mus_min_wCont" units="J_per_m3" interface="public"/>
    <variable name="P_plEE" units="J_per_m3" interface="public"/>
    <variable name="Delta_P_mus" units="J_per_m3" interface="public"/>
    <variable name="q_l" units="m3" initial_value="1.0e-2" interface="public"/>
    <variable name="q_t" units="m3" initial_value="1.0e-3" interface="public"/>
    <variable name="q_b" units="m3" initial_value="1.0e-3" interface="public"/>
    <variable name="q_A_stressed" units="m3" initial_value="0.0" interface="public"/>
    <variable name="q_A" units="m3" interface="public"/>
    <variable name="q_pl" units="m3" initial_value="0.0" interface="public"/>
    <variable name="q_D" units="m3" interface="public"/>
    <variable name="q_str" units="m3" interface="public"/>
    <variable name="v_ml" units="m3_per_s" interface="public"/>
    <variable name="v_lt" units="m3_per_s" interface="public"/>
    <variable name="v_tb" units="m3_per_s" interface="public"/>
    <variable name="v_bA" units="m3_per_s" interface="public"/>
    <variable name="v_twall" units="m3_per_s" interface="public"/>
    <variable name="v_bwall" units="m3_per_s" interface="public"/>
    <variable name="v_plwall" units="m3_per_s" interface="public"/>
    <variable name="R_ml" units="Js_per_m6" interface="public"/>
    <variable name="R_lt" units="Js_per_m6" interface="public"/>
    <variable name="R_tb" units="Js_per_m6" interface="public"/>
    <variable name="R_bA" units="Js_per_m6" interface="public"/>
    <variable name="alpha_LR" units="dimensionless" interface="public"/>
    <variable name="R_plwall" units="Js_per_m6" interface="public"/>
    <variable name="C_l" units="m6_per_J" interface="public"/>
    <variable name="C_t" units="m6_per_J" interface="public"/>
    <variable name="C_b" units="m6_per_J" interface="public"/>
    <variable name="C_A" units="m6_per_J" interface="public"/>
    <variable name="C_pl" units="m6_per_J" interface="public"/>
    <variable name="t_floor" units="second" interface="public"/>
    <variable name="T_resp" units="second" interface="public"/>
    <variable name="Delta_RR_resp" units="Hz" interface="public"/>
    <variable name="T_resp_wCont" units="second" interface="public"/>
    <variable name="T_I" units="second" interface="public"/>
    <variable name="T_E" units="second" interface="public"/>
    <variable name="tau" units="second" interface="public"/>
    <variable name="IE_ratio" units="dimensionless" interface="public"/>
    <variable name="q_l_us" units="m3" interface="public"/>
    <variable name="q_t_us" units="m3" interface="public"/>
    <variable name="q_b_us" units="m3" interface="public"/>
    <variable name="q_A_us" units="m3" interface="public"/>
    <variable name="flag_RR_control" units="dimensionless" interface="public"/>
    <variable name="flag_P_mus_control" units="dimensionless" interface="public"/>
    <variable name="q_D_min" units="m3" interface="public"/>
    <variable name="s" units="dimensionless" initial_value="0.0" interface="public"/>
    <variable name="s_floor" units="dimensionless" interface="public"/>
    <variable name="P_mus_max_wCont" units="J_per_m3" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>T_resp_wCont</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <apply>
            <plus/>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">1</cn>
              <ci>T_resp</ci>
            </apply>
            <apply>
              <times/>
              <ci>flag_RR_control</ci>
              <ci>Delta_RR_resp</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- We keep T_E and T_I based on T_resp, not T_resp control, then move through t_floor faster or slower
 as calculated below.-->
      <apply>
        <eq/>
        <ci>T_E</ci>
        <apply>
          <divide/>
          <ci>T_resp</ci>
          <apply>
            <plus/>
            <cn cellml:units="dimensionless">1</cn>
            <ci>IE_ratio</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>T_I</ci>
        <apply>
          <times/>
          <ci>T_E</ci>
          <ci>IE_ratio</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>tau</ci>
        <apply>
          <divide/>
          <ci>T_E</ci>
          <cn cellml:units="dimensionless">5</cn>
        </apply>
      </apply>
      <!-- TODO split this into submodules-->
      <apply>
        <eq/>
        <ci>v_ml</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>P_m</ci>
            <ci>P_l</ci>
          </apply>
          <apply>
            <times/>
            <ci>R_ml</ci>
            <ci>alpha_LR</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_l</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_ml</ci>
          <ci>v_lt</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>P_l</ci>
        <apply>
          <divide/>
          <ci>q_l</ci>
          <ci>C_l</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v_lt</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>P_l</ci>
            <ci>P_t</ci>
          </apply>
          <apply>
            <times/>
            <ci>R_lt</ci>
            <ci>alpha_LR</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v_twall</ci>
        <apply>
          <minus/>
          <ci>v_lt</ci>
          <ci>v_tb</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_t</ci>
        </apply>
        <ci>v_twall</ci>
      </apply>
      <apply>
        <eq/>
        <ci>P_t</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <ci>q_t</ci>
            <ci>C_t</ci>
          </apply>
          <ci>P_pl</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v_tb</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>P_t</ci>
            <ci>P_b</ci>
          </apply>
          <apply>
            <times/>
            <ci>R_tb</ci>
            <ci>alpha_LR</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v_bwall</ci>
        <apply>
          <minus/>
          <ci>v_tb</ci>
          <ci>v_bA</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_b</ci>
        </apply>
        <ci>v_bwall</ci>
      </apply>
      <apply>
        <eq/>
        <ci>P_b</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <ci>q_b</ci>
            <ci>C_b</ci>
          </apply>
          <ci>P_pl</ci>
        </apply>
      </apply>
      <!-- removing pleural pressure from bronchioles
 allows us to use q_b for a volume for stretch. This makes it varies about zero, 
 meaning we don't need a threshold, or the threshold can be zero.
 However, it's not physiological, so I am trying to fix it here.
 calculate the amount of stretched volume above baseline level.
 assuming a quater of the way from end expiratory pressure to min is baseline.-->
      <apply>
        <eq/>
        <ci>q_str</ci>
        <apply>
          <plus/>
          <ci>q_b</ci>
          <apply>
            <times/>
            <ci>C_b</ci>
            <apply>
              <plus/>
              <ci>P_plEE</ci>
              <apply>
                <divide/>
                <apply>
                  <minus/>
                  <ci>P_mus_min</ci>
                  <ci>P_plEE</ci>
                </apply>
                <cn cellml:units="dimensionless">4</cn>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- TODO change lung diagram.-->
      <apply>
        <eq/>
        <ci>v_bA</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>P_b</ci>
            <ci>P_A</ci>
          </apply>
          <apply>
            <times/>
            <ci>R_bA</ci>
            <ci>alpha_LR</ci>
          </apply>
        </apply>
      </apply>
      <!-- v_Awall = v_bA-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_A_stressed</ci>
        </apply>
        <ci>v_bA</ci>
      </apply>
      <apply>
        <eq/>
        <ci>P_A</ci>
        <apply>
          <plus/>
          <apply>
            <divide/>
            <ci>q_A_stressed</ci>
            <ci>C_A</ci>
          </apply>
          <ci>P_pl</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_pl</ci>
        </apply>
        <apply>
          <minus/>
          <apply>
            <minus/>
            <apply>
              <minus/>
              <ci>v_plwall</ci>
              <ci>v_twall</ci>
            </apply>
            <ci>v_bwall</ci>
          </apply>
          <ci>v_bA</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>P_pl</ci>
        <apply>
          <divide/>
          <ci>q_pl</ci>
          <ci>C_pl</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>v_plwall</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>P_mus</ci>
            <ci>P_pl</ci>
          </apply>
          <ci>R_plwall</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>q_D</ci>
        <apply>
          <max/>
          <apply>
            <plus/>
            <ci>q_l</ci>
            <ci>q_t</ci>
            <ci>q_b</ci>
            <ci>q_l_us</ci>
            <ci>q_t_us</ci>
            <ci>q_b_us</ci>
          </apply>
          <ci>q_D_min</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q_A</ci>
        <apply>
          <plus/>
          <ci>q_A_stressed</ci>
          <ci>q_A_us</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>s</ci>
        </apply>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <ci>T_resp_wCont</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>s_floor</ci>
        <apply>
          <minus/>
          <ci>s</ci>
          <apply>
            <floor/>
            <ci>s</ci>
          </apply>
        </apply>
      </apply>
      <!-- unnormalise (t_floor goes from 0 to T_resp, not T_resp_wCont) -->
      <apply>
        <eq/>
        <ci>t_floor</ci>
        <apply>
          <times/>
          <ci>s_floor</ci>
          <ci>T_resp</ci>
        </apply>
      </apply>
      <!-- TODO swap this muscle model for the one used in ben tal and smith 2008-->
      <apply>
        <eq/>
        <ci>P_mus_min_wCont</ci>
        <apply>
          <plus/>
          <ci>P_mus_min</ci>
          <apply>
            <times/>
            <ci>flag_P_mus_control</ci>
            <ci>Delta_P_mus</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>P_mus_max_wCont</ci>
        <apply>
          <plus/>
          <ci>P_plEE</ci>
          <apply>
            <max/>
            <apply>
              <times/>
              <apply>
                <minus/>
                <ci>flag_P_mus_control</ci>
              </apply>
              <ci>Delta_P_mus</ci>
            </apply>
            <cn cellml:units="J_per_m3">0</cn>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>P_mus</ci>
        <piecewise>
          <piece>
            <apply>
              <plus/>
              <apply>
                <minus/>
                <ci>P_mus_max_wCont</ci>
                <apply>
                  <times/>
                  <apply>
                    <divide/>
                    <apply>
                      <minus/>
                      <ci>P_mus_min_wCont</ci>
                      <ci>P_mus_max_wCont</ci>
                    </apply>
                    <apply>
                      <times/>
                      <ci>T_I</ci>
                      <ci>T_E</ci>
                    </apply>
                  </apply>
                  <apply>
                    <power/>
                    <ci>t_floor</ci>
                    <cn cellml:units="dimensionless">2</cn>
                  </apply>
                </apply>
              </apply>
              <apply>
                <times/>
                <apply>
                  <divide/>
                  <apply>
                    <times/>
                    <apply>
                      <minus/>
                      <ci>P_mus_min_wCont</ci>
                      <ci>P_mus_max_wCont</ci>
                    </apply>
                    <ci>T_resp</ci>
                  </apply>
                  <apply>
                    <times/>
                    <ci>T_I</ci>
                    <ci>T_E</ci>
                  </apply>
                </apply>
                <ci>t_floor</ci>
              </apply>
            </apply>
            <apply>
              <lt/>
              <ci>t_floor</ci>
              <ci>T_I</ci>
            </apply>
          </piece>
          <otherwise>
            <apply>
              <plus/>
              <ci>P_mus_max_wCont</ci>
              <apply>
                <times/>
                <apply>
                  <divide/>
                  <apply>
                    <minus/>
                    <ci>P_mus_min_wCont</ci>
                    <ci>P_mus_max_wCont</ci>
                  </apply>
                  <apply>
                    <minus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                      <exp/>
                      <apply>
                        <divide/>
                        <apply>
                          <minus/>
                          <ci>T_E</ci>
                        </apply>
                        <ci>tau</ci>
                      </apply>
                    </apply>
                  </apply>
                </apply>
                <apply>
                  <minus/>
                  <apply>
                    <exp/>
                    <apply>
                      <divide/>
                      <apply>
                        <minus/>
                        <apply>
                          <minus/>
                          <ci>t_floor</ci>
                          <ci>T_I</ci>
                        </apply>
                      </apply>
                      <ci>tau</ci>
                    </apply>
                  </apply>
                  <apply>
                    <exp/>
                    <apply>
                      <divide/>
                      <apply>
                        <minus/>
                        <ci>T_E</ci>
                      </apply>
                      <ci>tau</ci>
                    </apply>
                  </apply>
                </apply>
              </apply>
            </apply>
          </otherwise>
        </piecewise>
      </apply>
    </math>
  </component>
  <component name="pvn_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="I" units="Js2_per_m6" interface="public"/>
    <variable name="C" units="m6_per_J" interface="public"/>
    <variable name="R" units="Js_per_m6" interface="public"/>
    <variable name="R_v" units="Js_per_m6" interface="public"/>
    <variable name="u_ext" units="J_per_m3" interface="public"/>
    <variable name="v_in" units="m3_per_s" interface="public"/>
    <variable name="u" units="J_per_m3" interface="public"/>
    <variable name="q_C_init" units="m3" interface="public"/>
    <variable name="q_C_change" units="m3" initial_value="q_C_init" interface="public"/>
    <variable name="q_C" units="m3" interface="public"/>
    <variable name="q" units="m3" interface="public"/>
    <variable name="u_C" units="J_per_m3" interface="public"/>
    <variable name="v" units="m3_per_s" initial_value="0.0" interface="public"/>
    <variable name="u_out" units="J_per_m3" interface="public"/>
    <variable name="q_us_0" units="m3" interface="public"/>
    <variable name="q_us_wCont" units="m3" interface="public"/>
    <variable name="Delta_q_us" units="dimensionless" interface="public"/>
    <variable name="Delta_C" units="dimensionless" interface="public"/>
    <variable name="C_wCont" units="m6_per_J" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>R_v</ci>
        <apply>
          <divide/>
          <cn cellml:units="second">0.01</cn>
          <ci>C</ci>
        </apply>
      </apply>
      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <minus/>
              <ci>u</ci>
              <ci>u_out</ci>
            </apply>
            <apply>
              <times/>
              <ci>R</ci>
              <ci>v</ci>
            </apply>
          </apply>
          <ci>I</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C_change</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_in</ci>
          <ci>v</ci>
        </apply>
      </apply>
      <!-- TODO CHECK THAT CHANGING US VOLUME LIKE THIS CONSERVES VOLUME!!!!-->
      <apply>
        <eq/>
        <ci>q_C</ci>
        <apply>
          <minus/>
          <apply>
            <plus/>
            <ci>q_C_change</ci>
            <ci>q_us_0</ci>
          </apply>
          <ci>q_us_wCont</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_C</ci>
          <ci>q_us_wCont</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C</ci>
        <apply>
          <divide/>
          <ci>q_C</ci>
          <ci>C_wCont</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <ci>u_C</ci>
          <ci>u_ext</ci>
          <apply>
            <times/>
            <ci>R_v</ci>
            <apply>
              <minus/>
              <ci>v_in</ci>
              <ci>v</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q_us_wCont</ci>
        <apply>
          <times/>
          <ci>q_us_0</ci>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <ci>Delta_q_us</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>C_wCont</ci>
        <apply>
          <times/>
          <ci>C</ci>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <ci>Delta_C</ci>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="heart_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="s" units="dimensionless" initial_value="0.0" interface="public"/>
    <variable name="mt" units="dimensionless" interface="public"/>
    <variable name="e_a" units="dimensionless" interface="public"/>
    <variable name="e_v" units="dimensionless" interface="public"/>
    <variable name="T" units="second" interface="public"/>
    <variable name="T_ac" units="second" interface="public"/>
    <variable name="T_ar" units="second" interface="public"/>
    <variable name="t_astart" units="second" interface="public"/>
    <variable name="t_astart_norm" units="dimensionless" interface="public"/>
    <variable name="T_vc" units="second" interface="public"/>
    <variable name="T_vr" units="second" interface="public"/>
    <variable name="t_vstart" units="second" interface="public"/>
    <variable name="t_vstart_norm" units="dimensionless" interface="public"/>
    <variable name="T_wCont" units="second" interface="public"/>
    <variable name="T_ac_wCont" units="second" interface="public"/>
    <variable name="T_ar_wCont" units="second" interface="public"/>
    <variable name="T_vc_wCont" units="second" interface="public"/>
    <variable name="T_vr_wCont" units="second" interface="public"/>
    <variable name="E_lv_A" units="J_per_m6" interface="public"/>
    <variable name="E_lv_B" units="J_per_m6" interface="public"/>
    <variable name="E_la_A" units="J_per_m6" interface="public"/>
    <variable name="E_la_B" units="J_per_m6" interface="public"/>
    <variable name="E_rv_A" units="J_per_m6" interface="public"/>
    <variable name="E_rv_B" units="J_per_m6" interface="public"/>
    <variable name="E_ra_A" units="J_per_m6" interface="public"/>
    <variable name="E_ra_B" units="J_per_m6" interface="public"/>
    <variable name="q_ra_us" units="m3" interface="public"/>
    <variable name="q_rv_us" units="m3" interface="public"/>
    <variable name="q_la_us" units="m3" interface="public"/>
    <variable name="q_lv_us" units="m3" interface="public"/>
    <variable name="q_ra_init" units="m3" interface="public"/>
    <variable name="q_rv_init" units="m3" interface="public"/>
    <variable name="q_la_init" units="m3" interface="public"/>
    <variable name="q_lv_init" units="m3" interface="public"/>
    <variable name="u_ra" units="J_per_m3" interface="public"/>
    <variable name="u_rv" units="J_per_m3" interface="public"/>
    <variable name="u_la" units="J_per_m3" interface="public"/>
    <variable name="u_lv" units="J_per_m3" interface="public"/>
    <variable name="u_root" units="J_per_m3" interface="public"/>
    <variable name="u_par" units="J_per_m3" interface="public"/>
    <variable name="v_trv" units="m3_per_s" initial_value="0" interface="public"/>
    <variable name="v_puv" units="m3_per_s" initial_value="0" interface="public"/>
    <variable name="v_miv" units="m3_per_s" initial_value="0" interface="public"/>
    <variable name="v_aov" units="m3_per_s" initial_value="0" interface="public"/>
    <variable name="v_svc" units="m3_per_s" interface="public"/>
    <variable name="v_ivc" units="m3_per_s" interface="public"/>
    <variable name="v_pvn" units="m3_per_s" interface="public"/>
    <variable name="L_trv" units="Js2_per_m6"/>
    <variable name="L_puv" units="Js2_per_m6"/>
    <variable name="L_miv" units="Js2_per_m6"/>
    <variable name="L_aov" units="Js2_per_m6"/>
    <variable name="A_eff_trv" units="m2" interface="public"/>
    <variable name="A_eff_puv" units="m2" interface="public"/>
    <variable name="A_eff_miv" units="m2" interface="public"/>
    <variable name="A_eff_aov" units="m2" interface="public"/>
    <variable name="A_nn_trv" units="m2" interface="public"/>
    <variable name="A_nn_puv" units="m2" interface="public"/>
    <variable name="A_nn_miv" units="m2" interface="public"/>
    <variable name="A_nn_aov" units="m2" interface="public"/>
    <variable name="l_eff" units="metre" interface="public"/>
    <variable name="K_vo_trv" units="m3_per_Js" interface="public"/>
    <variable name="K_vo_puv" units="m3_per_Js" interface="public"/>
    <variable name="K_vo_miv" units="m3_per_Js" interface="public"/>
    <variable name="K_vo_aov" units="m3_per_Js" interface="public"/>
    <variable name="K_vc_trv" units="m3_per_Js" interface="public"/>
    <variable name="K_vc_puv" units="m3_per_Js" interface="public"/>
    <variable name="K_vc_miv" units="m3_per_Js" interface="public"/>
    <variable name="K_vc_aov" units="m3_per_Js" interface="public"/>
    <variable name="M_rg_trv" units="dimensionless" interface="public"/>
    <variable name="M_rg_puv" units="dimensionless" interface="public"/>
    <variable name="M_rg_miv" units="dimensionless" interface="public"/>
    <variable name="M_rg_aov" units="dimensionless" interface="public"/>
    <variable name="M_st_trv" units="dimensionless" interface="public"/>
    <variable name="M_st_puv" units="dimensionless" interface="public"/>
    <variable name="M_st_miv" units="dimensionless" interface="public"/>
    <variable name="M_st_aov" units="dimensionless" interface="public"/>
    <variable name="rho" units="kg_per_m3" interface="public"/>
    <variable name="B_trv" units="Js2_per_m9" interface="public"/>
    <variable name="B_puv" units="Js2_per_m9" interface="public"/>
    <variable name="B_miv" units="Js2_per_m9" interface="public"/>
    <variable name="B_aov" units="Js2_per_m9" interface="public"/>
    <variable name="zeta_trv" units="dimensionless" interface="public"/>
    <variable name="zeta_puv" units="dimensionless" interface="public"/>
    <variable name="zeta_miv" units="dimensionless" interface="public"/>
    <variable name="zeta_aov" units="dimensionless" interface="public"/>
    <variable name="zeta_trv_pre" units="dimensionless" initial_value="0" interface="public"/>
    <variable name="zeta_puv_pre" units="dimensionless" initial_value="0" interface="public"/>
    <variable name="zeta_miv_pre" units="dimensionless" initial_value="0" interface="public"/>
    <variable name="zeta_aov_pre" units="dimensionless" initial_value="0" interface="public"/>
    <variable name="eps_m4" units="m4" initial_value="1e-14"/>
    <variable name="eps_m2" units="m2" initial_value="1e-14"/>
    <variable name="eps_1" units="dimensionless" initial_value="0.07"/>
    <variable name="eps_2" units="dimensionless" initial_value="0.02"/>
    <variable name="q_lv" units="m3" initial_value="q_lv_init" interface="public"/>
    <variable name="q_rv" units="m3" initial_value="q_rv_init" interface="public"/>
    <variable name="q_la" units="m3" initial_value="q_la_init" interface="public"/>
    <variable name="q_ra" units="m3" initial_value="q_ra_init" interface="public"/>
    <variable name="chi_a" units="dimensionless" initial_value="0.0" interface="public"/>
    <variable name="chi_afloor" units="dimensionless" interface="public"/>
    <variable name="chi_afloor_final" units="dimensionless"/>
    <variable name="chi_v" units="dimensionless" initial_value="0.0"/>
    <variable name="chi_vfloor" units="dimensionless"/>
    <variable name="chi_vfloor_final" units="dimensionless"/>
    <variable name="Delta_T" units="second" interface="public"/>
    <variable name="T_min" units="second" interface="public"/>
    <variable name="E_rv_A_wCont" units="J_per_m6" interface="public"/>
    <variable name="E_lv_A_wCont" units="J_per_m6" interface="public"/>
    <variable name="Delta_E_rv" units="J_per_m6" interface="public"/>
    <variable name="Delta_E_lv" units="J_per_m6" interface="public"/>
    <variable name="q_heart" units="m3" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>chi_afloor</ci>
        <apply>
          <minus/>
          <ci>chi_a</ci>
          <apply>
            <floor/>
            <ci>chi_a</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>chi_a</ci>
        </apply>
        <piecewise>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.25</cn>
              <ci>T_ac_wCont</ci>
            </apply>
            <apply>
              <and/>
              <apply>
                <geq/>
                <ci>mt</ci>
                <ci>t_astart_norm</ci>
              </apply>
              <apply>
                <leq/>
                <ci>mt</ci>
                <apply>
                  <plus/>
                  <ci>t_astart_norm</ci>
                  <ci>eps_1</ci>
                </apply>
              </apply>
              <apply>
                <leq/>
                <ci>chi_afloor</ci>
                <cn cellml:units="dimensionless">0.25</cn>
              </apply>
            </apply>
          </piece>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.25</cn>
              <ci>T_ac_wCont</ci>
            </apply>
            <apply>
              <and/>
              <apply>
                <gt/>
                <apply>
                  <plus/>
                  <ci>t_astart_norm</ci>
                  <ci>eps_1</ci>
                </apply>
                <cn cellml:units="dimensionless">1.0</cn>
              </apply>
              <apply>
                <leq/>
                <ci>mt</ci>
                <apply>
                  <minus/>
                  <apply>
                    <plus/>
                    <ci>t_astart_norm</ci>
                    <ci>eps_1</ci>
                  </apply>
                  <cn cellml:units="dimensionless">1.0</cn>
                </apply>
              </apply>
              <apply>
                <leq/>
                <ci>chi_afloor</ci>
                <cn cellml:units="dimensionless">0.25</cn>
              </apply>
            </apply>
          </piece>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.25</cn>
              <ci>T_ac_wCont</ci>
            </apply>
            <apply>
              <and/>
              <apply>
                <gt/>
                <ci>chi_afloor</ci>
                <ci>eps_2</ci>
              </apply>
              <apply>
                <leq/>
                <ci>chi_afloor</ci>
                <cn cellml:units="dimensionless">0.25</cn>
              </apply>
            </apply>
          </piece>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.25</cn>
              <ci>T_ar_wCont</ci>
            </apply>
            <apply>
              <and/>
              <apply>
                <geq/>
                <ci>chi_afloor</ci>
                <cn cellml:units="dimensionless">0.25</cn>
              </apply>
              <apply>
                <lt/>
                <ci>chi_afloor</ci>
                <cn cellml:units="dimensionless">0.5</cn>
              </apply>
            </apply>
          </piece>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.5</cn>
              <apply>
                <minus/>
                <apply>
                  <minus/>
                  <ci>T_wCont</ci>
                  <ci>T_ac_wCont</ci>
                </apply>
                <ci>T_ar_wCont</ci>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>chi_afloor</ci>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="Hz">0.0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>chi_afloor_final</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>chi_afloor</ci>
              <cn cellml:units="dimensionless">2</cn>
            </apply>
            <apply>
              <leq/>
              <ci>chi_afloor</ci>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0.0</cn>
          </otherwise>
        </piecewise>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>chi_vfloor</ci>
        <apply>
          <minus/>
          <ci>chi_v</ci>
          <apply>
            <floor/>
            <ci>chi_v</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>chi_v</ci>
        </apply>
        <piecewise>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.25</cn>
              <ci>T_vc_wCont</ci>
            </apply>
            <apply>
              <and/>
              <apply>
                <geq/>
                <ci>mt</ci>
                <ci>t_vstart_norm</ci>
              </apply>
              <apply>
                <leq/>
                <ci>mt</ci>
                <apply>
                  <plus/>
                  <ci>t_vstart_norm</ci>
                  <ci>eps_1</ci>
                </apply>
              </apply>
              <apply>
                <leq/>
                <ci>chi_vfloor</ci>
                <cn cellml:units="dimensionless">0.25</cn>
              </apply>
            </apply>
          </piece>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.25</cn>
              <ci>T_vc_wCont</ci>
            </apply>
            <apply>
              <and/>
              <apply>
                <gt/>
                <apply>
                  <plus/>
                  <ci>t_vstart_norm</ci>
                  <ci>eps_1</ci>
                </apply>
                <cn cellml:units="dimensionless">1.0</cn>
              </apply>
              <apply>
                <leq/>
                <ci>mt</ci>
                <apply>
                  <minus/>
                  <apply>
                    <plus/>
                    <ci>t_vstart_norm</ci>
                    <ci>eps_1</ci>
                  </apply>
                  <cn cellml:units="dimensionless">1.0</cn>
                </apply>
              </apply>
              <apply>
                <leq/>
                <ci>chi_vfloor</ci>
                <cn cellml:units="dimensionless">0.25</cn>
              </apply>
            </apply>
          </piece>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.25</cn>
              <ci>T_vc_wCont</ci>
            </apply>
            <apply>
              <and/>
              <apply>
                <gt/>
                <ci>chi_vfloor</ci>
                <ci>eps_2</ci>
              </apply>
              <apply>
                <leq/>
                <ci>chi_vfloor</ci>
                <cn cellml:units="dimensionless">0.25</cn>
              </apply>
            </apply>
          </piece>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.25</cn>
              <ci>T_vr_wCont</ci>
            </apply>
            <apply>
              <and/>
              <apply>
                <gt/>
                <ci>chi_vfloor</ci>
                <cn cellml:units="dimensionless">0.25</cn>
              </apply>
              <apply>
                <lt/>
                <ci>chi_vfloor</ci>
                <cn cellml:units="dimensionless">0.5</cn>
              </apply>
            </apply>
          </piece>
          <piece>
            <apply>
              <divide/>
              <cn cellml:units="dimensionless">0.5</cn>
              <apply>
                <minus/>
                <apply>
                  <minus/>
                  <ci>T_wCont</ci>
                  <ci>T_vc_wCont</ci>
                </apply>
                <ci>T_vr_wCont</ci>
              </apply>
            </apply>
            <apply>
              <gt/>
              <ci>chi_vfloor</ci>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="Hz">0.0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <ci>chi_vfloor_final</ci>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <ci>chi_vfloor</ci>
              <cn cellml:units="dimensionless">2</cn>
            </apply>
            <apply>
              <leq/>
              <ci>chi_vfloor</ci>
              <cn cellml:units="dimensionless">0.5</cn>
            </apply>
          </piece>
          <otherwise>
            <cn cellml:units="dimensionless">0.0</cn>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>s</ci>
        </apply>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <ci>T_wCont</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>mt</ci>
        <apply>
          <minus/>
          <ci>s</ci>
          <apply>
            <floor/>
            <ci>s</ci>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>T_wCont</ci>
        <apply>
          <max/>
          <apply>
            <plus/>
            <ci>T</ci>
            <ci>Delta_T</ci>
          </apply>
          <ci>T_min</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>T_ac_wCont</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>T_ac</ci>
            <ci>T_wCont</ci>
          </apply>
          <ci>T</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>T_ar_wCont</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>T_ar</ci>
            <ci>T_wCont</ci>
          </apply>
          <ci>T</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>T_vc_wCont</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>T_vc</ci>
            <ci>T_wCont</ci>
          </apply>
          <ci>T</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>T_vr_wCont</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>T_vr</ci>
            <ci>T_wCont</ci>
          </apply>
          <ci>T</ci>
        </apply>
      </apply>
      <!-- Elastance Functions
 TODO FIGURE OUT A REALISTIC WAY TO CONTROL t_astart and t_vstart so that it changes with changes in period-->
      <apply>
        <eq/>
        <ci>t_astart_norm</ci>
        <apply>
          <divide/>
          <ci>t_astart</ci>
          <ci>T</ci>
        </apply>
      </apply>
      <!-- T_ac_norm = T_ac/T;
 T_ar_norm = T_ar/T;-->
      <apply>
        <eq/>
        <ci>t_vstart_norm</ci>
        <apply>
          <divide/>
          <ci>t_vstart</ci>
          <ci>T</ci>
        </apply>
      </apply>
      <!-- T_vc_norm = T_vc/T;
 T_vr_norm = T_vr/T;-->
      <apply>
        <eq/>
        <ci>e_a</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">0.5</cn>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <cos/>
              <apply>
                <times/>
                <cn cellml:units="dimensionless">2</cn>
                <pi/>
                <ci>chi_afloor_final</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>e_v</ci>
        <apply>
          <times/>
          <cn cellml:units="dimensionless">0.5</cn>
          <apply>
            <minus/>
            <cn cellml:units="dimensionless">1</cn>
            <apply>
              <cos/>
              <apply>
                <times/>
                <cn cellml:units="dimensionless">2</cn>
                <pi/>
                <ci>chi_vfloor_final</ci>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- Valve model-->
      <apply>
        <eq/>
        <ci>B_trv</ci>
        <apply>
          <divide/>
          <ci>rho</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">2</cn>
              <apply>
                <power/>
                <ci>A_eff_trv</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
            </apply>
            <ci>eps_m4</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>B_puv</ci>
        <apply>
          <divide/>
          <ci>rho</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">2</cn>
              <apply>
                <power/>
                <ci>A_eff_puv</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
            </apply>
            <ci>eps_m4</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>B_miv</ci>
        <apply>
          <divide/>
          <ci>rho</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">2</cn>
              <apply>
                <power/>
                <ci>A_eff_miv</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
            </apply>
            <ci>eps_m4</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>B_aov</ci>
        <apply>
          <divide/>
          <ci>rho</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <cn cellml:units="dimensionless">2</cn>
              <apply>
                <power/>
                <ci>A_eff_aov</ci>
                <cn cellml:units="dimensionless">2</cn>
              </apply>
            </apply>
            <ci>eps_m4</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>L_trv</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>rho</ci>
            <ci>l_eff</ci>
          </apply>
          <apply>
            <plus/>
            <ci>A_eff_trv</ci>
            <ci>eps_m2</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>L_puv</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>rho</ci>
            <ci>l_eff</ci>
          </apply>
          <apply>
            <plus/>
            <ci>A_eff_puv</ci>
            <ci>eps_m2</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>L_miv</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>rho</ci>
            <ci>l_eff</ci>
          </apply>
          <apply>
            <plus/>
            <ci>A_eff_miv</ci>
            <ci>eps_m2</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>L_aov</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>rho</ci>
            <ci>l_eff</ci>
          </apply>
          <apply>
            <plus/>
            <ci>A_eff_aov</ci>
            <ci>eps_m2</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>A_eff_trv</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <apply>
                <times/>
                <ci>M_st_trv</ci>
                <ci>A_nn_trv</ci>
              </apply>
              <apply>
                <times/>
                <ci>M_rg_trv</ci>
                <ci>A_nn_trv</ci>
              </apply>
            </apply>
            <ci>zeta_trv</ci>
          </apply>
          <apply>
            <times/>
            <ci>M_rg_trv</ci>
            <ci>A_nn_trv</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>A_eff_puv</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <apply>
                <times/>
                <ci>M_st_puv</ci>
                <ci>A_nn_puv</ci>
              </apply>
              <apply>
                <times/>
                <ci>M_rg_puv</ci>
                <ci>A_nn_puv</ci>
              </apply>
            </apply>
            <ci>zeta_puv</ci>
          </apply>
          <apply>
            <times/>
            <ci>M_rg_puv</ci>
            <ci>A_nn_puv</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>A_eff_miv</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <apply>
                <times/>
                <ci>M_st_miv</ci>
                <ci>A_nn_miv</ci>
              </apply>
              <apply>
                <times/>
                <ci>M_rg_miv</ci>
                <ci>A_nn_miv</ci>
              </apply>
            </apply>
            <ci>zeta_miv</ci>
          </apply>
          <apply>
            <times/>
            <ci>M_rg_miv</ci>
            <ci>A_nn_miv</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>A_eff_aov</ci>
        <apply>
          <plus/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <apply>
                <times/>
                <ci>M_st_aov</ci>
                <ci>A_nn_aov</ci>
              </apply>
              <apply>
                <times/>
                <ci>M_rg_aov</ci>
                <ci>A_nn_aov</ci>
              </apply>
            </apply>
            <ci>zeta_aov</ci>
          </apply>
          <apply>
            <times/>
            <ci>M_rg_aov</ci>
            <ci>A_nn_aov</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>zeta_trv_pre</ci>
        </apply>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <apply>
                <minus/>
                <cn cellml:units="dimensionless">1</cn>
                <ci>zeta_trv_pre</ci>
              </apply>
              <ci>K_vo_trv</ci>
              <apply>
                <minus/>
                <ci>u_ra</ci>
                <ci>u_rv</ci>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>u_ra</ci>
              <ci>u_rv</ci>
            </apply>
          </piece>
          <otherwise>
            <apply>
              <times/>
              <ci>zeta_trv_pre</ci>
              <ci>K_vc_trv</ci>
              <apply>
                <minus/>
                <ci>u_ra</ci>
                <ci>u_rv</ci>
              </apply>
            </apply>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>zeta_puv_pre</ci>
        </apply>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <apply>
                <minus/>
                <cn cellml:units="dimensionless">1</cn>
                <ci>zeta_puv_pre</ci>
              </apply>
              <ci>K_vo_puv</ci>
              <apply>
                <minus/>
                <ci>u_rv</ci>
                <ci>u_par</ci>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>u_rv</ci>
              <ci>u_par</ci>
            </apply>
          </piece>
          <otherwise>
            <apply>
              <times/>
              <ci>zeta_puv_pre</ci>
              <ci>K_vc_puv</ci>
              <apply>
                <minus/>
                <ci>u_rv</ci>
                <ci>u_par</ci>
              </apply>
            </apply>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>zeta_miv_pre</ci>
        </apply>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <apply>
                <minus/>
                <cn cellml:units="dimensionless">1</cn>
                <ci>zeta_miv_pre</ci>
              </apply>
              <ci>K_vo_miv</ci>
              <apply>
                <minus/>
                <ci>u_la</ci>
                <ci>u_lv</ci>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>u_la</ci>
              <ci>u_lv</ci>
            </apply>
          </piece>
          <otherwise>
            <apply>
              <times/>
              <ci>zeta_miv_pre</ci>
              <ci>K_vc_miv</ci>
              <apply>
                <minus/>
                <ci>u_la</ci>
                <ci>u_lv</ci>
              </apply>
            </apply>
          </otherwise>
        </piecewise>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>zeta_aov_pre</ci>
        </apply>
        <piecewise>
          <piece>
            <apply>
              <times/>
              <apply>
                <minus/>
                <cn cellml:units="dimensionless">1</cn>
                <ci>zeta_aov_pre</ci>
              </apply>
              <ci>K_vo_aov</ci>
              <apply>
                <minus/>
                <ci>u_lv</ci>
                <ci>u_root</ci>
              </apply>
            </apply>
            <apply>
              <geq/>
              <ci>u_lv</ci>
              <ci>u_root</ci>
            </apply>
          </piece>
          <otherwise>
            <apply>
              <times/>
              <ci>zeta_aov_pre</ci>
              <ci>K_vc_aov</ci>
              <apply>
                <minus/>
                <ci>u_lv</ci>
                <ci>u_root</ci>
              </apply>
            </apply>
          </otherwise>
        </piecewise>
      </apply>
      <!-- The below ensures zeta can't be negative-->
      <apply>
        <eq/>
        <ci>zeta_trv</ci>
        <apply>
          <max/>
          <ci>zeta_trv_pre</ci>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>zeta_puv</ci>
        <apply>
          <max/>
          <ci>zeta_puv_pre</ci>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>zeta_miv</ci>
        <apply>
          <max/>
          <ci>zeta_miv_pre</ci>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>zeta_aov</ci>
        <apply>
          <max/>
          <ci>zeta_aov_pre</ci>
          <cn cellml:units="dimensionless">0</cn>
        </apply>
      </apply>
      <!-- calculate the flow through the valves-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v_trv</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>B_trv</ci>
                </apply>
                <ci>v_trv</ci>
                <apply>
                  <abs/>
                  <ci>v_trv</ci>
                </apply>
              </apply>
              <ci>u_ra</ci>
            </apply>
            <ci>u_rv</ci>
          </apply>
          <ci>L_trv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v_puv</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>B_puv</ci>
                </apply>
                <ci>v_puv</ci>
                <apply>
                  <abs/>
                  <ci>v_puv</ci>
                </apply>
              </apply>
              <ci>u_rv</ci>
            </apply>
            <ci>u_par</ci>
          </apply>
          <ci>L_puv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v_miv</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>B_miv</ci>
                </apply>
                <ci>v_miv</ci>
                <apply>
                  <abs/>
                  <ci>v_miv</ci>
                </apply>
              </apply>
              <ci>u_la</ci>
            </apply>
            <ci>u_lv</ci>
          </apply>
          <ci>L_miv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v_aov</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <plus/>
              <apply>
                <times/>
                <apply>
                  <minus/>
                  <ci>B_aov</ci>
                </apply>
                <ci>v_aov</ci>
                <apply>
                  <abs/>
                  <ci>v_aov</ci>
                </apply>
              </apply>
              <ci>u_lv</ci>
            </apply>
            <ci>u_root</ci>
          </apply>
          <ci>L_aov</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>E_rv_A_wCont</ci>
        <apply>
          <plus/>
          <ci>E_rv_A</ci>
          <ci>Delta_E_rv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>E_lv_A_wCont</ci>
        <apply>
          <plus/>
          <ci>E_lv_A</ci>
          <ci>Delta_E_lv</ci>
        </apply>
      </apply>
      <!-- Constitutive Relations-->
      <apply>
        <eq/>
        <ci>u_ra</ci>
        <apply>
          <times/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>e_a</ci>
              <ci>E_ra_A</ci>
            </apply>
            <ci>E_ra_B</ci>
          </apply>
          <apply>
            <minus/>
            <ci>q_ra</ci>
            <ci>q_ra_us</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_rv</ci>
        <apply>
          <times/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>e_v</ci>
              <ci>E_rv_A_wCont</ci>
            </apply>
            <ci>E_rv_B</ci>
          </apply>
          <apply>
            <minus/>
            <ci>q_rv</ci>
            <ci>q_rv_us</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_la</ci>
        <apply>
          <times/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>e_a</ci>
              <ci>E_la_A</ci>
            </apply>
            <ci>E_la_B</ci>
          </apply>
          <apply>
            <minus/>
            <ci>q_la</ci>
            <ci>q_la_us</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_lv</ci>
        <apply>
          <times/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>e_v</ci>
              <ci>E_lv_A_wCont</ci>
            </apply>
            <ci>E_lv_B</ci>
          </apply>
          <apply>
            <minus/>
            <ci>q_lv</ci>
            <ci>q_lv_us</ci>
          </apply>
        </apply>
      </apply>
      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_ra</ci>
        </apply>
        <apply>
          <minus/>
          <apply>
            <plus/>
            <ci>v_svc</ci>
            <ci>v_ivc</ci>
          </apply>
          <ci>v_trv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_rv</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_trv</ci>
          <ci>v_puv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_la</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_pvn</ci>
          <ci>v_miv</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_lv</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_miv</ci>
          <ci>v_aov</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>q_heart</ci>
        <apply>
          <plus/>
          <ci>q_ra</ci>
          <ci>q_rv</ci>
          <ci>q_la</ci>
          <ci>q_lv</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="ascending_aorta_A_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="mu" units="Js_per_m3" interface="public"/>
    <variable name="rho" units="kg_per_m3" interface="public"/>
    <variable name="g" units="m_per_s2" interface="public"/>
    <variable name="beta_g" units="dimensionless" interface="public"/>
    <variable name="theta" units="dimensionless" interface="public"/>
    <variable name="E" units="J_per_m3" interface="public"/>
    <variable name="l" units="metre" interface="public"/>
    <variable name="h" units="metre" interface="public"/>
    <variable name="r_0" units="metre" interface="public"/>
    <variable name="u_0" units="J_per_m3" interface="public"/>
    <variable name="I" units="Js2_per_m6" interface="public"/>
    <variable name="C" units="m6_per_J" interface="public"/>
    <variable name="R" units="Js_per_m6" interface="public"/>
    <variable name="R_v" units="Js_per_m6" interface="public"/>
    <variable name="a_vessel" units="dimensionless" interface="public"/>
    <variable name="b_vessel" units="per_m" interface="public"/>
    <variable name="c_vessel" units="dimensionless" interface="public"/>
    <variable name="d_vessel" units="per_m" interface="public"/>
    <variable name="u_ext" units="J_per_m3" interface="public"/>
    <variable name="v_in" units="m3_per_s" interface="public"/>
    <variable name="u" units="J_per_m3" interface="public"/>
    <variable name="u_C" units="J_per_m3" interface="public"/>
    <variable name="v" units="m3_per_s" initial_value="0.0" interface="public"/>
    <variable name="u_d" units="J_per_m3" interface="public"/>
    <variable name="u_C_d" units="J_per_m3" interface="public"/>
    <variable name="v_out" units="m3_per_s" interface="public"/>
    <variable name="q_C" units="m3" initial_value="0.0" interface="public"/>
    <variable name="q_C_d" units="m3" initial_value="0.0" interface="public"/>
    <variable name="q_0" units="m3" interface="public"/>
    <variable name="q" units="m3" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>q_0</ci>
        <apply>
          <times/>
          <pi/>
          <apply>
            <power/>
            <ci>r_0</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
          <ci>l</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_C</ci>
          <ci>q_C_d</ci>
          <ci>q_0</ci>
        </apply>
      </apply>
      <!-- Constitutive Relations-->
      <apply>
        <eq/>
        <ci>h</ci>
        <apply>
          <times/>
          <ci>r_0</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>a_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>b_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>c_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>d_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>I</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>rho</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">2</cn>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>C</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">2</cn>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <ci>E</ci>
            <ci>h</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">8</cn>
            <ci>mu</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">4</cn>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R_v</ci>
        <apply>
          <divide/>
          <cn cellml:units="second">0.01</cn>
          <ci>C</ci>
        </apply>
      </apply>
      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <ci>u</ci>
                <ci>u_d</ci>
              </apply>
              <apply>
                <times/>
                <ci>R</ci>
                <ci>v</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>beta_g</ci>
              <ci>rho</ci>
              <ci>g</ci>
              <ci>l</ci>
              <apply>
                <cos/>
                <apply>
                  <divide/>
                  <apply>
                    <times/>
                    <ci>theta</ci>
                    <pi/>
                  </apply>
                  <cn cellml:units="dimensionless">180</cn>
                </apply>
              </apply>
            </apply>
          </apply>
          <ci>I</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_in</ci>
          <ci>v</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C</ci>
        <apply>
          <divide/>
          <ci>q_C</ci>
          <apply>
            <divide/>
            <ci>C</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C_d</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v</ci>
          <ci>v_out</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C_d</ci>
        <apply>
          <divide/>
          <ci>q_C_d</ci>
          <apply>
            <divide/>
            <ci>C</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C</ci>
          <ci>u_ext</ci>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">2</cn>
            <ci>R_v</ci>
            <apply>
              <minus/>
              <ci>v_in</ci>
              <ci>v</ci>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_d</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C_d</ci>
          <ci>u_ext</ci>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">2</cn>
            <ci>R_v</ci>
            <apply>
              <minus/>
              <ci>v</ci>
              <ci>v_out</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
  </component>
  <component name="ascending_aorta_B_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="mu" units="Js_per_m3" interface="public"/>
    <variable name="rho" units="kg_per_m3" interface="public"/>
    <variable name="g" units="m_per_s2" interface="public"/>
    <variable name="beta_g" units="dimensionless" interface="public"/>
    <variable name="theta" units="dimensionless" interface="public"/>
    <variable name="E" units="J_per_m3" interface="public"/>
    <variable name="l" units="metre" interface="public"/>
    <variable name="h" units="metre" interface="public"/>
    <variable name="r_0" units="metre" interface="public"/>
    <variable name="u_0" units="J_per_m3" interface="public"/>
    <variable name="I" units="Js2_per_m6" interface="public"/>
    <variable name="C" units="m6_per_J" interface="public"/>
    <variable name="R" units="Js_per_m6" interface="public"/>
    <variable name="R_v" units="Js_per_m6" interface="public"/>
    <variable name="a_vessel" units="dimensionless" interface="public"/>
    <variable name="b_vessel" units="per_m" interface="public"/>
    <variable name="c_vessel" units="dimensionless" interface="public"/>
    <variable name="d_vessel" units="per_m" interface="public"/>
    <variable name="u_ext" units="J_per_m3" interface="public"/>
    <variable name="u_in" units="J_per_m3" interface="public"/>
    <variable name="v" units="m3_per_s" initial_value="0.0" interface="public"/>
    <variable name="u" units="J_per_m3" interface="public"/>
    <variable name="u_C" units="J_per_m3" interface="public"/>
    <variable name="v_out" units="m3_per_s" interface="public"/>
    <variable name="q_C" units="m3" initial_value="0.0" interface="public"/>
    <variable name="q_0" units="m3" interface="public"/>
    <variable name="q" units="m3" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>q_0</ci>
        <apply>
          <times/>
          <pi/>
          <apply>
            <power/>
            <ci>r_0</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
          <ci>l</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_C</ci>
          <ci>q_0</ci>
        </apply>
      </apply>
      <!-- Constitutive Relations-->
      <apply>
        <eq/>
        <ci>h</ci>
        <apply>
          <times/>
          <ci>r_0</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>a_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>b_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>c_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>d_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>I</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>rho</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">2</cn>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>C</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">2</cn>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <ci>E</ci>
            <ci>h</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">8</cn>
            <ci>mu</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">4</cn>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R_v</ci>
        <apply>
          <divide/>
          <cn cellml:units="second">0.01</cn>
          <ci>C</ci>
        </apply>
      </apply>
      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>v</ci>
        </apply>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <ci>u_in</ci>
                <ci>u</ci>
              </apply>
              <apply>
                <times/>
                <ci>R</ci>
                <ci>v</ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>beta_g</ci>
              <ci>rho</ci>
              <ci>g</ci>
              <ci>l</ci>
              <apply>
                <cos/>
                <apply>
                  <divide/>
                  <apply>
                    <times/>
                    <ci>theta</ci>
                    <pi/>
                  </apply>
                  <cn cellml:units="dimensionless">180</cn>
                </apply>
              </apply>
            </apply>
          </apply>
          <ci>I</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v</ci>
          <ci>v_out</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C</ci>
        <apply>
          <divide/>
          <ci>q_C</ci>
          <ci>C</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C</ci>
          <ci>u_ext</ci>
          <apply>
            <times/>
            <ci>R_v</ci>
            <apply>
              <minus/>
              <ci>v</ci>
              <ci>v_out</ci>
            </apply>
          </apply>
        </apply>
      </apply>
    </math>
