    <variable name="v_leg_R_T" units="m3_per_s" interface="public"/>
    <variable name="v_venous_lb" units="m3_per_s" interface="public"/>
    <variable name="v_venous_ub" units="m3_per_s" interface="public"/>
    <variable name="C_O2_p_middle_cerebral_L_GE" units="dimensionless" interface="public"/>
    <variable name="C_CO2_p_middle_cerebral_L_GE" units="dimensionless" interface="public"/>
    <variable name="C_O2_p_middle_cerebral_R_GE" units="dimensionless" interface="public"/>
    <variable name="C_CO2_p_middle_cerebral_R_GE" units="dimensionless" interface="public"/>
