          </apply>
          <ci>l</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_C</ci>
          <ci>q_0</ci>
        </apply>
      </apply>
