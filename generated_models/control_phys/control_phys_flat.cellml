    <variable name="C_CO2_p_leg_R_GE" units="dimensionless" interface="public"/>
    <variable name="C_O2_p_trunk_C_GE" units="dimensionless" interface="public"/>
    <variable name="C_CO2_p_trunk_C_GE" units="dimensionless" interface="public"/>
    <variable name="C_O2_p_venous_ave" units="dimensionless" interface="public"/>
    <variable name="C_CO2_p_venous_ave" units="dimensionless" interface="public"/>
    <variable name="v_venous_total" units="m3_per_s" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>v_venous_lb</ci>
        <apply>
          <plus/>
          <ci>v_trunk_C_T</ci>
          <ci>v_leg_L_T</ci>
          <ci>v_leg_R_T</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>v_venous_ub</ci>
        <apply>
          <plus/>
          <ci>v_posterior_cerebral_L_T</ci>
          <ci>v_posterior_cerebral_R_T</ci>
          <ci>v_external_carotid_L_T</ci>
          <ci>v_external_carotid_R_T</ci>
          <ci>v_middle_cerebral_L_T</ci>
          <ci>v_middle_cerebral_R_T</ci>
          <ci>v_anterior_cerebral_L_T</ci>
          <ci>v_anterior_cerebral_R_T</ci>
          <ci>v_arm_L_T</ci>
          <ci>v_arm_R_T</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML">
      <apply>
        <eq/>
        <ci>v_venous_total</ci>
        <apply>
          <plus/>
          <ci>v_posterior_cerebral_L_T</ci>
          <ci>v_posterior_cerebral_R_T</ci>
          <ci>v_external_carotid_L_T</ci>
          <ci>v_external_carotid_R_T</ci>
          <ci>v_middle_cerebral_L_T</ci>
          <ci>v_middle_cerebral_R_T</ci>
          <ci>v_anterior_cerebral_L_T</ci>
          <ci>v_anterior_cerebral_R_T</ci>
          <ci>v_arm_L_T</ci>
          <ci>v_arm_R_T</ci>
          <ci>v_trunk_C_T</ci>
          <ci>v_leg_L_T</ci>
          <ci>v_leg_R_T</ci>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>C_O2_p_venous_ave</ci>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>C_O2_p_middle_cerebral_L_GE</ci>
              <ci>v_posterior_cerebral_L_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_middle_cerebral_R_GE</ci>
              <ci>v_posterior_cerebral_R_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_anterior_cerebral_L_GE</ci>
              <ci>v_external_carotid_L_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_anterior_cerebral_R_GE</ci>
              <ci>v_external_carotid_R_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_posterior_cerebral_L_GE</ci>
              <ci>v_middle_cerebral_L_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_posterior_cerebral_R_GE</ci>
              <ci>v_middle_cerebral_R_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_external_carotid_L_GE</ci>
              <ci>v_anterior_cerebral_L_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_external_carotid_R_GE</ci>
              <ci>v_anterior_cerebral_R_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_arm_L_GE</ci>
              <ci>v_arm_L_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_arm_R_GE</ci>
              <ci>v_arm_R_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_leg_L_GE</ci>
              <ci>v_trunk_C_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_leg_R_GE</ci>
              <ci>v_leg_L_T</ci>
            </apply>
            <apply>
              <times/>
              <ci>C_O2_p_trunk_C_GE</ci>
              <ci>v_leg_R_T</ci>
            </apply>
          </apply>
          <apply>
            <plus/>
            <apply>
              <abs/>
              <apply>
                <plus/>
                <ci>v_posterior_cerebral_L_T</ci>
                <ci>v_posterior_cerebral_R_T</ci>
                <ci>v_external_carotid_L_T</ci>
                <ci>v_external_carotid_R_T</ci>
                <ci>v_middle_cerebral_L_T</ci>
                <ci>v_middle_cerebral_R_T</ci>
                <ci>v_anterior_cerebral_L_T</ci>
                <ci>v_anterior_cerebral_R_T</ci>
                <ci>v_arm_L_T</ci>
                <ci>v_arm_R_T</ci>
                <ci>v_trunk_C_T</ci>
                <ci>v_leg_L_T</ci>
                <ci>v_leg_R_T</ci>
              </apply>
            </apply>
            <cn type="e-notation" cellml:units="m3_per_s">1<sep/>-10</cn>
          </apply>
        </apply>
      </apply>
    </math>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>C_CO2_p_venous_ave</ci>
        <apply>
          <divide/>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>C_CO2_p_middle_cerebral_L_GE</ci>
