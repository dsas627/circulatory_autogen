              <ci>x_O2</ci>
            </apply>
          </apply>
          <ci>x_CO2</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R_local_multiplier</ci>
        <apply>
          <divide/>
          <cn cellml:units="dimensionless">1</cn>
          <ci>G_p</ci>
        </apply>
      </apply>
    </math>
