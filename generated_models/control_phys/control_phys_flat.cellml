        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">8</cn>
            <ci>mu</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">4</cn>
            </apply>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
