      <apply>
        <eq/>
        <ci>u_C</ci>
        <apply>
          <divide/>
          <ci>q_C</ci>
          <ci>C</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C</ci>
          <ci>u_ext</ci>
        </apply>
      </apply>
      <!--+R_v*(v-v_d);-->
      <apply>
        <eq/>
        <ci>v_d</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u</ci>
            <ci>u_out</ci>
          </apply>
          <apply>
            <divide/>
            <ci>R</ci>
            <cn cellml:units="dimensionless">2</cn>
