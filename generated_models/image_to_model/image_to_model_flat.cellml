        <apply>
          <divide/>
          <ci>q_C</ci>
          <ci>C</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C</ci>
          <ci>u_ext</ci>
        </apply>
