          <ci>u_C</ci>
          <ci>u_ext</ci>
          <cn cellml:units="J_per_m3">2</cn>
        </apply>
      </apply>
      <!--*R_v*(v_in-v);-->
      <apply>
        <eq/>
        <ci>u_d</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C_d</ci>
          <ci>u_ext</ci>
          <cn cellml:units="J_per_m3">2</cn>
        </apply>
      </apply>
    </math>
