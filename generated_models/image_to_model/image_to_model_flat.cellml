      <!-- R_v = 0.01{second}/C;-->
      <apply>
        <eq/>
        <ci>R_v</ci>
        <cn cellml:units="Js_per_m6">0.0</cn>
      </apply>
      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <ci>v</ci>
        <apply>
          <divide/>
          <apply>
