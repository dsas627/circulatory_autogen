      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <ci>v</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u_in</ci>
            <ci>u</ci>
          </apply>
          <apply>
            <divide/>
            <ci>R</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v</ci>
          <ci>v_d</ci>
        </apply>
