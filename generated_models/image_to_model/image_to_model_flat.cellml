                <apply>
                  <times/>
                  <ci>d_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- I   = rho*l/(pi*sqr(r_0));-->
      <apply>
        <eq/>
        <ci>C</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">2</cn>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <ci>E</ci>
            <ci>h</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">8</cn>
            <ci>mu</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">4</cn>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- R_v = 0.01{second}/C;-->
      <apply>
        <eq/>
        <ci>R_v</ci>
        <cn cellml:units="Js_per_m6">0.0</cn>
      </apply>
      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <ci>v</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u</ci>
            <ci>u_d</ci>
          </apply>
          <ci>R</ci>
        </apply>
      </apply>
      <!-- ode(v, t)     = (u-u_d-R*v-beta_g*rho*g*l*cos(theta*pi/180{dimensionless}))/I;-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_in</ci>
          <ci>v</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C</ci>
        <apply>
          <divide/>
          <ci>q_C</ci>
          <apply>
            <divide/>
            <ci>C</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C_d</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v</ci>
          <ci>v_out</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C_d</ci>
        <apply>
          <divide/>
          <ci>q_C_d</ci>
          <apply>
            <divide/>
            <ci>C</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C</ci>
          <ci>u_ext</ci>
          <cn cellml:units="J_per_m3">2</cn>
        </apply>
      </apply>
      <!--*R_v*(v_in-v);-->
      <apply>
        <eq/>
        <ci>u_d</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C_d</ci>
          <ci>u_ext</ci>
          <cn cellml:units="J_per_m3">2</cn>
        </apply>
      </apply>
    </math>
  </component>
  <component name="L2_E74_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="mu" units="Js_per_m3" interface="public"/>
    <variable name="rho" units="kg_per_m3" interface="public"/>
    <variable name="g" units="m_per_s2" interface="public"/>
    <variable name="beta_g" units="dimensionless" interface="public"/>
    <variable name="theta" units="dimensionless" interface="public"/>
    <variable name="E" units="J_per_m3" interface="public"/>
    <variable name="l" units="metre" interface="public"/>
    <variable name="h" units="metre" interface="public"/>
    <variable name="r_0" units="metre" interface="public"/>
    <variable name="u_0" units="J_per_m3" interface="public"/>
    <variable name="C" units="m6_per_J" interface="public"/>
    <variable name="R" units="Js_per_m6" interface="public"/>
    <variable name="R_v" units="Js_per_m6" interface="public"/>
    <variable name="a_vessel" units="dimensionless" interface="public"/>
    <variable name="b_vessel" units="per_m" interface="public"/>
    <variable name="c_vessel" units="dimensionless" interface="public"/>
    <variable name="d_vessel" units="per_m" interface="public"/>
    <variable name="u_ext" units="J_per_m3" interface="public"/>
    <variable name="v_in" units="m3_per_s" interface="public"/>
    <variable name="u" units="J_per_m3" interface="public"/>
    <variable name="u_C" units="J_per_m3" interface="public"/>
    <variable name="v" units="m3_per_s" interface="public"/>
    <variable name="u_out" units="J_per_m3" interface="public"/>
    <variable name="q_C" units="m3" initial_value="0.0" interface="public"/>
    <variable name="q_0" units="m3" interface="public"/>
    <variable name="q" units="m3" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <ci>q_0</ci>
        <apply>
          <times/>
          <pi/>
          <apply>
            <power/>
            <ci>r_0</ci>
            <cn cellml:units="dimensionless">2</cn>
          </apply>
          <ci>l</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_C</ci>
          <ci>q_0</ci>
        </apply>
      </apply>
      <!-- Constitutive Relations-->
      <apply>
        <eq/>
        <ci>h</ci>
        <apply>
          <times/>
          <ci>r_0</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>a_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>b_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci>c_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>d_vessel</ci>
                  <ci>r_0</ci>
                </apply>
              </apply>
            </apply>
          </apply>
        </apply>
      </apply>
      <!--C = 2{dimensionless}*pi*pow(r, 3{dimensionless})*l/(E*h);-->
      <apply>
        <eq/>
        <ci>C</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">2</cn>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <ci>E</ci>
            <ci>h</ci>
          </apply>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>R</ci>
        <apply>
          <divide/>
          <apply>
            <times/>
            <cn cellml:units="dimensionless">8</cn>
            <ci>mu</ci>
            <ci>l</ci>
          </apply>
          <apply>
            <times/>
            <pi/>
            <apply>
              <power/>
              <ci>r_0</ci>
              <cn cellml:units="dimensionless">4</cn>
            </apply>
          </apply>
        </apply>
      </apply>
      <!-- R_v = 0.01{second}/C;-->
      <apply>
        <eq/>
        <ci>R_v</ci>
        <cn cellml:units="Js_per_m6">0.0</cn>
      </apply>
      <!-- Conservation Laws-->
      <apply>
        <eq/>
        <ci>v</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u</ci>
            <ci>u_out</ci>
          </apply>
          <ci>R</ci>
        </apply>
      </apply>
      <!-- ode(v, t)   = (u-u_out-R*v-beta_g*rho*g*l*cos(theta*pi/180{dimensionless}))/I;-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v_in</ci>
          <ci>v</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C</ci>
        <apply>
          <divide/>
          <ci>q_C</ci>
          <ci>C</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C</ci>
          <ci>u_ext</ci>
        </apply>
      </apply>
    </math>
  </component>
