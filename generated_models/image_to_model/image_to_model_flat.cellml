        <eq/>
        <ci>v</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u_in</ci>
            <ci>u</ci>
          </apply>
          <ci>R</ci>
        </apply>
      </apply>
      <!-- ode(v, t)   = (u_in-u-R*v-beta_g*rho*g*l*cos(theta*pi/180{dimensionless}))/I;-->
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
