        <apply>
          <plus/>
          <ci>u_0</ci>
          <ci>u_C</ci>
          <ci>u_ext</ci>
        </apply>
      </apply>
      <!--+R_v*(v-v_d);-->
      <apply>
        <eq/>
        <ci>v_d</ci>
        <apply>
          <divide/>
          <apply>
            <minus/>
            <ci>u</ci>
