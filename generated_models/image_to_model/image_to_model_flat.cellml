      </apply>
      <apply>
        <eq/>
        <ci>q</ci>
        <apply>
          <plus/>
          <ci>q_0</ci>
          <ci>q_C</ci>
          <ci>q_C_d</ci>
        </apply>
      </apply>
      <!-- Constitutive Relations-->
      <apply>
        <eq/>
        <ci>h</ci>
        <apply>
          <times/>
          <ci>r_0</ci>
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci>a_vessel</ci>
              <apply>
                <exp/>
                <apply>
                  <times/>
                  <ci>b_vessel</ci>
