        </apply>
        <apply>
          <minus/>
          <ci>v_in</ci>
          <ci>v</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C</ci>
        <apply>
          <divide/>
          <ci>q_C</ci>
          <ci>C</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u</ci>
        <apply>
