        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>q_C</ci>
        </apply>
        <apply>
          <minus/>
          <ci>v</ci>
          <ci>v_d</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <ci>u_C</ci>
        <apply>
          <divide/>
          <ci>q_C</ci>
          <ci>C</ci>
        </apply>
